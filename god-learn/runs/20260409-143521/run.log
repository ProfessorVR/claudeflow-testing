      "bboxes": "[{\"page_num\": 172, \"coords\": [55.81054687499999, 308.6086708982475, 345.601318359375, 523.0998665769584], \"blocks\": [[55.81054687499999, 308.6086708982475, 345.601318359375, 523.0998665769584]]}, {\"page_num\": 173, \"coords\": [38.44921875, 49.3896484375, 328.8818054199219, 280.07757348613814], \"blocks\": [[38.44921875, 49.3896484375, 328.8818054199219, 280.07757348613814]]}, {\"page_num\": 174, \"coords\": [67.3241958618164, 80.47607421875, 305.9582214355469, 125.09064428706188], \"blocks\": [[67.3241958618164, 80.47607421875, 305.9582214355469, 125.09064428706188]]}, {\"page_num\": 175, \"coords\": [42.902801513671875, 80.90234375, 335.11376953125, 525.199236693792], \"blocks\": [[74.50279998779297, 80.90234375, 307.82244873046875, 123.31357080023736], [73.26189422607422, 139.978515625, 275.5677795410156, 161.79962426703423], [75.33280181884766, 162.677734375, 306.46893310546875, 173.26019555609673], [71.806640625, 180.720703125, 283.0314025878906, 200.90805322211236], [222.6005859375, 204.29296875, 305.5602111816406, 212.5511806635186], [71.806640625, 219.42578125, 305.61883544921875, 241.54296875], [127.3623046875, 242.416015625, 305.644775390625, 251.68487817328423], [42.902801513671875, 332.33984375, 335.11376953125, 525.199236693792]]}]",
