      "bboxes": "[{\"page_num\": 254, \"coords\": [46.56275303643725, 48.75, 336.45344129554655, 527.0390625], \"blocks\": [[47.31376518218624, 48.75, 336.45344129554655, 405.7734375], [46.56275303643725, 405.7734375, 336.45344129554655, 527.0390625]]}, {\"page_num\": 255, \"coords\": [32.2265625, 53.0537109375, 325.3779296875, 356.2487813718617], \"blocks\": [[32.2265625, 53.0537109375, 322.6302490234375, 185.9794921875], [32.2265625, 186.5625, 325.3779296875, 356.2487813718617]]}]",
