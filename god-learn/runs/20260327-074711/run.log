      "bboxes": "[{\"page_num\": 290, \"coords\": [42.380001068115234, 63.22998809814453, 356.9100036621094, 592.3699951171875], \"blocks\": [[42.380001068115234, 63.22998809814453, 356.9100036621094, 592.3699951171875]]}, {\"page_num\": 291, \"coords\": [42.2599983215332, 39.23698806762695, 231.66098022460938, 51.4630126953125], \"blocks\": [[42.2599983215332, 39.23698806762695, 231.66098022460938, 51.4630126953125]]}]",
