      "bboxes": "[{\"page_num\": 268, \"coords\": [54.349998474121094, 320.8344421386719, 196.11138916015625, 544.2005004882812], \"blocks\": [[54.349998474121094, 320.8344421386719, 196.11138916015625, 544.2005004882812]]}, {\"page_num\": 269, \"coords\": [31.950000762939453, 13.351133346557617, 362.3996276855469, 544.1184692382812], \"blocks\": [[313.1000061035156, 13.351133346557617, 362.3996276855469, 23.508485794067383], [33.45000076293945, 49.70146179199219, 177.25, 408.17388916015625], [185.85000610351562, 52.12714385986328, 332.6000061035156, 543.3519897460938], [31.950000762939453, 420.8046875, 170.30184936523438, 544.1184692382812]]}, {\"page_num\": 270, \"coords\": [34.349998474121094, 9.842723846435547, 200.5500030517578, 545.8770751953125], \"blocks\": [[34.349998474121094, 9.842723846435547, 83.59886932373047, 31.429523468017578], [60.95000076293945, 53.15788269042969, 200.5500030517578, 342.7694396972656], [58.54899978637695, 353.94097900390625, 199.36399841308594, 545.8770751953125]]}]",
