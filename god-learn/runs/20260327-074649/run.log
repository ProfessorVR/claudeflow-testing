5], [538.8802490234375, 308.2159118652344, 547.7252197265625, 332.3130187988281], [487.9653625488281, 34.040584564208984, 497.2861633300781, 332.5450134277344], [521.5324096679688, 33.34455871582031, 530.9615478515625, 332.5450134277344], [530.0763549804688, 33.698421478271484, 539.295166015625, 332.7480163574219], [462.90679931640625, 34.222625732421875, 472.0811462402344, 332.81500244140625], [437.75543212890625, 34.41299057006836, 447.1443786621094, 332.89501953125], [445.8898010253906, 33.98806381225586, 455.51715087890625, 332.9750061035156], [479.5240173339844, 33.73628234863281, 490.0747985839844, 332.9779968261719], [496.4583435058594, 34.396331787109375, 505.56634521484375, 332.9940185546875], [470.9617919921875, 33.958778381347656, 480.45257568359375, 333.0039978027344], [505.23077392578125, 240.4684295654297, 513.8432006835938, 333.0159912109375]]}]",
