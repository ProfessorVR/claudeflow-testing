28125], [499.5113525390625, 170.90773010253906, 512.2035522460938, 326.4410400390625], [507.653076171875, 35.7553825378418, 519.9668579101562, 326.4620361328125], [533.0464477539062, 35.99432373046875, 546.0182495117188, 326.4630126953125], [451.9557189941406, 34.984378814697266, 463.3232116699219, 333.32904052734375], [526.80419921875, 143.80853271484375, 536.0518798828125, 333.5710144042969], [492.95831298828125, 270.68914794921875, 501.9647521972656, 333.7550354003906], [518.7950439453125, 35.734130859375, 530.0344848632812, 333.80401611328125], [406.9117736816406, 35.035552978515625, 418.89459228515625, 333.8440246582031], [384.8514404296875, 35.208396911621094, 396.10894775390625, 333.87103271484375], [429.7354431152344, 34.71393966674805, 441.24688720703125, 333.8750305175781], [395.94854736328125, 35.410030364990234, 407.44647216796875, 333.8790283203125], [418.45245361328125, 34.77656936645508, 430.00592041015625, 333.8890380859375]]}]",
