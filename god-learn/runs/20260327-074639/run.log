3281, 203.21905517578125], [142.3061065673828, 259.77838134765625, 270.2425842285156, 276.5867614746094], [36.756099700927734, 285.3061828613281, 354.80908203125, 309.2568054199219], [35.846099853515625, 313.51678466796875, 146.2271728515625, 326.5899963378906], [35.373504638671875, 331.14678955078125, 140.81045532226562, 344.2201843261719], [85.55609893798828, 368.186767578125, 321.58331298828125, 381.2640075683594], [32.03609848022461, 391.49676513671875, 372.46734619140625, 460.72998046875], [31.180892944335938, 471.25518798828125, 368.7449035644531, 574.5601806640625]]}, {\"page_num\": 184, \"coords\": [68.65660095214844, 21.359088897705078, 285.0030517578125, 35.87762451171875], \"blocks\": [[68.65660095214844, 21.359088897705078, 285.0030517578125, 35.87762451171875]]}]",
