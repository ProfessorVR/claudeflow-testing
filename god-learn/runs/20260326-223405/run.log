        "bboxes": "[{\"page_num\": 121, \"coords\": [25.409698486328125, 262.7428894042969, 310.2575378417969, 468.50360107421875], \"blocks\": [[26.379776000976562, 262.7428894042969, 308.4078063964844, 272.6259765625], [26.599761962890625, 273.9898986816406, 308.4466857910156, 283.84600830078125], [26.599761962890625, 284.9790954589844, 309.16375732421875, 327.4216003417969], [26.599761962890625, 328.3728942871094, 310.2575378417969, 338.2560119628906], [26.599777221679688, 339.1391296386719, 308.8221740722656, 348.8060302734375], [26.169769287109375, 354.96832275390625, 308.3884582519531, 392.95361328125], [25.8697509765625, 392.6008605957031, 306.9362487792969, 409.3536071777344], [25.409698486328125, 409.120849609375, 308.0749206542969, 468.50360107421875]]}, {\"page_num\": 122, \"coords\": [23.89996337890625, 8.840310096740723, 328.2328186035156, 401.9688415527344], \"blocks\": [[24.219999313354492, 8.840310096740723, 307.0707092285156, 22.86756134033203], [23.89996337890625, 22.332799911499023, 308.19378662109375, 130.23878479003906], [24.1700439453125, 130.64279174804688, 328.2328186035156, 401.9688415527344]]}]",
