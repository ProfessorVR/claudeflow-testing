.1240234375, 88.12821197509766], [21.839935302734375, 87.81241607666016, 305.0811767578125, 99.15821075439453], [21.629913330078125, 98.02800750732422, 331.0299987792969, 109.9382095336914], [21.629913330078125, 109.29242706298828, 305.3018798828125, 131.5082244873047], [21.629913330078125, 131.18350219726562, 304.8377990722656, 143.0082244873047], [30.489913940429688, 142.0924072265625, 304.94940185546875, 153.43821716308594], [21.629913330078125, 152.88241577148438, 305.49627685546875, 164.2282257080078], [21.2799072265625, 163.80242919921875, 305.1617126464844, 175.1482391357422], [21.83990478515625, 174.77243041992188, 305.4725646972656, 186.1182403564453], [21.409881591796875, 185.742431640625, 305.4686584472656, 197.08824157714844], [21.189910888671875, 196.46243286132812, 303.193115234375, 207.97044372558594]]}]",
