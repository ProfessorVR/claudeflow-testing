      "bboxes": "[{\"page_num\": 126, \"coords\": [388.3900146484375, 385.0377197265625, 395.8798828125, 519.627197265625], \"blocks\": [[389.8900146484375, 385.0377197265625, 395.8798828125, 404.28485107421875], [388.3900146484375, 420.05084228515625, 394.4048156738281, 440.35369873046875], [389.0, 490.8157958984375, 394.4134521484375, 519.627197265625]]}, {\"page_num\": 127, \"coords\": [26.89900016784668, 12.207871437072754, 356.0998840332031, 534.8309326171875], \"blocks\": [[238.69000244140625, 12.207871437072754, 356.0998840332031, 23.60918617248535], [65.1500015258789, 63.53645706176758, 190.66075134277344, 77.39250183105469], [211.5, 465.3648376464844, 306.6400146484375, 489.11944580078125], [26.89900016784668, 106.32891845703125, 326.3500061035156, 534.8309326171875]]}, {\"page_num\": 128, \"coords\": [71.69999694824219, 16.640987396240234, 397.1400146484375, 549.1361694335938], \"blocks\": [[71.69999694824219, 16.640987396240234, 278.1185302734375, 28.13011360168457], [309.79998779296875, 194.69065856933594, 365.42962646484375, 210.35751342773438], [123.08999633789062, 278.9364929199219, 259.03924560546875, 292.7925109863281], [101.30000305175781, 307.4187927246094, 397.1400146484375, 549.1361694335938]]}, {\"page_num\": 129, \"coords\": [26.89900016784668, 0.6306095123291016, 361.2624816894531, 306.92987060546875], \"blocks\": [[239.3000030517578, 0.6306095123291016, 361.2624816894531, 38.34312438964844], [26.89900016784668, 52.40147399902344, 326.6400146484375, 306.92987060546875]]}]",
