      "bboxes": "[{\"page_num\": 72, \"coords\": [102.44999694824219, 186.0648651123047, 397.45001220703125, 550.1668090820312], \"blocks\": [[103.05000305175781, 186.0648651123047, 341.0, 240.23008728027344], [102.44999694824219, 264.2613525390625, 397.45001220703125, 550.1668090820312]]}, {\"page_num\": 73, \"coords\": [30.14900016784668, 12.1409273147583, 329.3500061035156, 548.4063110351562], \"blocks\": [[253.0500030517578, 12.1409273147583, 325.9941101074219, 23.63005256652832], [218.69000244140625, 205.9893035888672, 297.95001220703125, 240.08819580078125], [218.69000244140625, 247.1885986328125, 293.7752685546875, 271.36944580078125], [30.14900016784668, 347.6113586425781, 329.3500061035156, 548.4063110351562]]}, {\"page_num\": 74, \"coords\": [101.9000015258789, 16.340938568115234, 398.3500061035156, 549.36181640625], \"blocks\": [[101.9000015258789, 16.340938568115234, 279.0085144042969, 27.83006477355957], [102.44999694824219, 51.068721771240234, 396.8500061035156, 177.21080017089844], [140.10000610351562, 221.32191467285156, 230.73033142089844, 234.7379608154297], [103.6500015258789, 264.02191162109375, 398.3500061035156, 549.36181640625]]}]",
