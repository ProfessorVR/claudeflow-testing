999938964844, 507.05902099609375], [11.899999618530273, 469.24847412109375, 385.0672912597656, 510.710205078125], [7.75, 516.9738159179688, 26.50815773010254, 527.4631958007812], [224.0500030517578, 548.1104736328125, 233.9105224609375, 553.3718872070312], [349.29998779296875, 549.515869140625, 365.40740966796875, 554.899169921875], [49.70000076293945, 532.9852905273438, 88.64997863769531, 556.6071166992188], [40.45000076293945, 544.2784423828125, 329.7237243652344, 598.7438354492188]]}, {\"page_num\": 198, \"coords\": [40.150001525878906, 97.33016967773438, 341.66363525390625, 536.5098876953125], \"blocks\": [[169.0, 97.33016967773438, 215.77784729003906, 111.71915435791016], [94.30000305175781, 132.0777587890625, 287.0818176269531, 144.9614715576172], [41.04899978637695, 147.22718811035156, 338.6299743652344, 164.83372497558594], [40.150001525878906, 169.8782196044922, 341.66363525390625, 536.5098876953125]]}, {\"page_num\": 199, \"coords\": [48.20000076293945, 27.241485595703125, 348.79998779296875, 538.1588745117188], \"blocks\": [[178.8000030517578, 27.241485595703125, 212.6022186279297, 36.420162200927734], [56.849998474121094, 34.79961395263672, 348.79998779296875, 117.12615966796875], [56.540008544921875, 109.80986022949219, 347.8900146484375, 142.80923461914062], [48.20000076293945, 145.8892364501953, 347.3500061035156, 538.1588745117188]]}, {\"page_num\": 200, \"coords\": [36.0, 21.529544830322266, 339.06585693359375, 536.28369140625], \"blocks\": [[171.94000244140625, 21.529544830322266, 335.63330078125, 35.72747039794922], [36.0, 33.16001510620117, 339.06585693359375, 536.28369140625]]}]",
