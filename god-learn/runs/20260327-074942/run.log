      "bboxes": "[{\"page_num\": 189, \"coords\": [27.09991455078125, 312.2693786621094, 312.1159362792969, 470.1065368652344], \"blocks\": [[27.2498779296875, 312.2693786621094, 310.2630615234375, 333.5224914550781], [27.459869384765625, 334.5871887207031, 310.1717529296875, 344.3289794921875], [27.139862060546875, 345.4871520996094, 312.1159362792969, 355.22894287109375], [27.359832763671875, 356.3071594238281, 310.0586853027344, 366.0489501953125], [27.67987060546875, 366.857177734375, 309.0182800292969, 376.5989685058594], [27.679901123046875, 377.8171691894531, 310.75848388671875, 387.5589599609375], [27.09991455078125, 388.65716552734375, 310.6280212402344, 398.3989562988281], [27.389923095703125, 399.4771728515625, 310.69061279296875, 409.2189636230469], [27.899932861328125, 410.337158203125, 310.7239074707031, 420.0789489746094], [27.899917602539062, 421.1271667480469, 310.7305908203125, 430.86895751953125], [49.72990417480469, 442.83294677734375, 290.3629150390625, 451.3045654296875], [50.169921875, 450.1157531738281, 199.76300048828125, 460.9970703125], [49.72991943359375, 460.2807922363281, 227.11732482910156, 470.1065368652344]]}, {\"page_num\": 190, \"coords\": [21.170074462890625, 10.008596420288086, 329.0431213378906, 467.9983825683594], \"blocks\": [[133.6300048828125, 10.008596420288086, 304.06256103515625, 20.50253677368164], [21.170074462890625, 22.914386749267578, 329.0431213378906, 434.8027648925781], [22.280120849609375, 436.8808288574219, 304.305908203125, 467.9983825683594]]}]",
