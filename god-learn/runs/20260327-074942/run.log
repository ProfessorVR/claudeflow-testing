1.599899291992188, 176.69528198242188, 302.9284973144531, 186.16668701171875], [22.2799072265625, 187.51528930664062, 303.1007995605469, 196.9866943359375], [22.279922485351562, 198.16209411621094, 303.2918701171875, 208.61485290527344], [22.059906005859375, 209.5552978515625, 301.682373046875, 219.02670288085938], [22.489883422851562, 220.5153045654297, 303.1021728515625, 229.98670959472656], [21.839874267578125, 231.41529846191406, 328.43206787109375, 252.26670837402344], [21.459869384765625, 252.42581176757812, 303.6771545410156, 263.30712890625], [21.9798583984375, 264.5152893066406, 303.4605712890625, 273.9866943359375], [22.279876708984375, 275.4753112792969, 304.5227966308594, 284.94671630859375], [20.329864501953125, 285.6820983886719, 303.69659423828125, 306.8648376464844], [22.059890747070312, 308.0152893066406, 101.35049438476562, 317.4866943359375], [31.56989288330078, 318.7853088378906, 301.489990234375, 328.2567138671875], [22.279876708984375, 329.7153015136719, 303.02337646484375, 339.18670654296875], [22.4898681640625, 340.61529541015625, 301.48638916015625, 350.0867004394531], [22.279876708984375, 351.48529052734375, 303.2171630859375, 361.3334045410156], [22.05987548828125, 360.9057922363281, 302.8019714355469, 371.787109375], [21.839874267578125, 373.0752868652344, 301.2716064453125, 382.7164001464844], [21.839889526367188, 384.12530517578125, 302.8072814941406, 393.5967102050781], [21.629913330078125, 394.57086181640625, 302.8469543457031, 415.41510009765625], [30.489913940429688, 416.86529541015625, 302.9178161621094, 426.3367004394531], [21.139923095703125, 427.86529541015625, 302.71258544921875, 437.3367004394531], [21.409927368164062, 438.6952819824219, 302.39202880859375, 448.16668701171875], [21.409942626953125, 449.7853088378906, 302.92572021484375, 470.55133056640625]]}, {\"page_num\": 415, \"coords\": [27.459991455078125, 9.752098083496094, 309.90521240234375, 130.98080444335938], \"blocks\": [[27.459991455078125, 9.752098083496094, 308.3370361328125, 33.64485168457031], [27.869979858398438, 34.44361114501953, 308.26422119140625, 44.02081298828125], [27.680023193359375, 45.363624572753906, 308.4231262207031, 54.940826416015625], [27.46002197265625, 56.20362091064453, 308.4166259765625, 65.78082275390625], [27.9000244140625, 67.02362823486328, 308.8058776855469, 76.600830078125], [27.680023193359375, 77.96363067626953, 308.58447265625, 87.54083251953125], [27.67999267578125, 88.8636245727539, 309.88519287109375, 98.44082641601562], [28.110015869140625, 99.76361846923828, 309.0496520996094, 109.3408203125], [27.680023193359375, 110.63361358642578, 309.90521240234375, 120.2108154296875], [28.170013427734375, 121.40360260009766, 308.6462097167969, 130.98080444335938]]}]",
