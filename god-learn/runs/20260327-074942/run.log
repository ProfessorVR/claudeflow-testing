      "bboxes": "[{\"page_num\": 112, \"coords\": [34.060211181640625, 284.43609619140625, 317.7730712890625, 470.7635803222656], \"blocks\": [[35.33013916015625, 284.43609619140625, 316.3727111816406, 294.1029968261719], [35.520111083984375, 295.0078430175781, 314.8503723144531, 305.0885925292969], [35.2501220703125, 306.1161193847656, 316.3940124511719, 315.78302001953125], [35.2501220703125, 317.1560974121094, 316.214111328125, 326.822998046875], [35.2501220703125, 327.9861145019531, 316.150146484375, 337.65301513671875], [35.030120849609375, 338.81610107421875, 316.19500732421875, 348.4830017089844], [35.2501220703125, 349.7261047363281, 316.16864013671875, 359.39300537109375], [35.5201416015625, 360.6260986328125, 315.8780822753906, 370.2929992675781], [35.90016174316406, 371.2861022949219, 315.6417236328125, 380.9530029296875], [35.03016662597656, 382.07611083984375, 316.5234680175781, 391.7430114746094], [35.030181884765625, 393.0461120605469, 317.7730712890625, 402.7130126953125], [35.25018310546875, 402.8927917480469, 315.33367919921875, 413.77410888671875], [34.060211181640625, 414.76611328125, 316.72100830078125, 463.468994140625], [41.73017883300781, 460.9378356933594, 112.03868103027344, 470.7635803222656]]}, {\"page_num\": 113, \"coords\": [5.839996337890625, 10.97819709777832, 310.1150817871094, 468.4930725097656], \"blocks\": [[138.60000610351562, 10.97819709777832, 196.86480712890625, 20.558597564697266], [5.839996337890625, 23.971187591552734, 309.14898681640625, 98.74877166748047], [26.979949951171875, 99.77780151367188, 310.1150817871094, 468.4930725097656]]}, {\"page_num\": 114, \"coords\": [135.57000732421875, 10.691179275512695, 305.89508056640625, 20.37933921813965], \"blocks\": [[135.57000732421875, 10.691179275512695, 305.89508056640625, 20.37933921813965]]}]",
