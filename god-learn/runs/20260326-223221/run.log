 507.88201904296875, 634.1835327148438], [90.00103759765625, 642.9471435546875, 507.7099914550781, 654.9435424804688], [90.00103759765625, 662.8209838867188, 507.9110412597656, 676.5096435546875], [90.00003051757812, 685.9071044921875, 181.26524353027344, 697.9035034179688], [89.99903106689453, 704.73583984375, 507.44293212890625, 737.6127319335938], [89.99932861328125, 743.257568359375, 507.398193359375, 766.6531372070312]]}, {\"page_num\": 18, \"coords\": [50.3997802734375, 35.61199951171875, 545.1142578125, 513.1898193359375], \"blocks\": [[292.6342468261719, 35.61199951171875, 545.1142578125, 60.9119987487793], [50.3997802734375, 35.61199951171875, 192.92977905273438, 72.91199493408203], [111.60098266601562, 134.1474151611328, 507.7230224609375, 146.14381408691406], [90.00094604492188, 152.9808349609375, 507.84686279296875, 168.18988037109375], [90.00094604492188, 175.78082275390625, 507.9379577636719, 190.9898681640625], [90.00094604492188, 200.9873809814453, 507.91796875, 213.30987548828125], [90.00091552734375, 223.30738830566406, 507.91497802734375, 235.6298828125], [90.00088500976562, 245.5074005126953, 507.8808288574219, 257.82989501953125], [90.00088500976562, 267.827392578125, 507.81768798828125, 280.14990234375], [90.00090026855469, 289.4273681640625, 507.70989990234375, 301.42376708984375], [90.00090026855469, 307.6736145019531, 390.1167297363281, 322.18377685546875], [90.0029296875, 336.2135009765625, 396.1170959472656, 349.7498779296875], [111.6029052734375, 369.7073669433594, 507.72491455078125, 381.7037658691406], [90.00387573242188, 390.34735107421875, 218.5666961669922, 402.34375], [90.00287628173828, 418.4361267089844, 507.732177734375, 459.66986083984375], [111.60192108154297, 479.6273498535156, 507.72369384765625, 491.6237487792969], [90.00189208984375, 499.5011901855469, 507.676513671875, 513.1898193359375]]}]",
