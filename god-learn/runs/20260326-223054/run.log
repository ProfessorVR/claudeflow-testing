        "bboxes": "[{\"page_num\": 103, \"coords\": [5.6400146484375, 98.94071197509766, 308.7869873046875, 469.72467041015625], \"blocks\": [[25.569976806640625, 98.94071197509766, 307.5596923828125, 240.0191192626953], [25.440032958984375, 240.96852111816406, 307.2967834472656, 338.589111328125], [5.6400146484375, 339.04071044921875, 308.7869873046875, 457.91485595703125], [58.81999206542969, 460.1210632324219, 275.97998046875, 469.72467041015625]]}, {\"page_num\": 104, \"coords\": [22.979949951171875, 9.588197708129883, 327.3464660644531, 469.43597412109375], \"blocks\": [[24.81999969482422, 9.588197708129883, 305.1889953613281, 21.5734806060791], [23.35986328125, 23.504501342773438, 327.3464660644531, 447.79534912109375], [22.979949951171875, 453.07830810546875, 305.26092529296875, 469.43597412109375]]}, {\"page_num\": 105, \"coords\": [15.630218505859375, 9.592094421386719, 299.5567626953125, 304.9679260253906], \"blocks\": [[18.3799991607666, 9.592094421386719, 298.7550964355469, 21.402095794677734], [15.630218505859375, 23.926010131835938, 299.5567626953125, 304.9679260253906]]}]",
