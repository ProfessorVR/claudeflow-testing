      "bboxes": "[{\"page_num\": 264, \"coords\": [57.04899978637695, 318.7803039550781, 353.79998779296875, 532.1231079101562], \"blocks\": [[57.04899978637695, 318.7803039550781, 353.79998779296875, 532.1231079101562]]}, {\"page_num\": 265, \"coords\": [31.049999237060547, 13.339454650878906, 358.4994201660156, 318.86944580078125], \"blocks\": [[307.1000061035156, 13.339454650878906, 358.4994201660156, 24.518577575683594], [31.049999237060547, 50.390926361083984, 330.25, 318.86944580078125]]}, {\"page_num\": 266, \"coords\": [22.100000381469727, 63.7105827331543, 352.95001220703125, 582.0220947265625], \"blocks\": [[95.9000015258789, 63.7105827331543, 124.69247436523438, 74.77770233154297], [208.25, 162.3514862060547, 352.95001220703125, 432.630126953125], [57.349998474121094, 163.5771484375, 199.39999389648438, 545.14501953125], [208.25, 443.6485900878906, 351.45001220703125, 545.4450073242188], [22.100000381469727, 570.532958984375, 44.20045471191406, 582.0220947265625]]}, {\"page_num\": 267, \"coords\": [310.1000061035156, 8.247980117797852, 359.6894226074219, 18.540443420410156], \"blocks\": [[310.1000061035156, 8.247980117797852, 359.6894226074219, 18.540443420410156]]}]",
