        "bboxes": "[{\"page_num\": 3, \"coords\": [87.85546875, 271.4765625, 520.3500366210938, 689.3534317016602], \"blocks\": [[149.4140625, 271.4765625, 520.3500366210938, 379.3533630371094], [88.453125, 394.725830078125, 139.33200073242188, 406.725830078125], [89.349609375, 413.40234375, 147.239990234375, 424.7715148925781], [147.0234375, 431.3533630371094, 505.1900329589844, 453.3533630371094], [87.85546875, 465.99609375, 139.4499969482422, 476.7715148925781], [148.21875, 481.8515625, 511.9999694824219, 613.3534240722656], [88.453125, 626.7715454101562, 112.78999328613281, 636.7715454101562], [148.21875, 642.33984375, 518.6600341796875, 689.3534317016602]]}, {\"page_num\": 4, \"coords\": [88.453125, 60.328125, 521.6200561523438, 445.5], \"blocks\": [[149.4140625, 60.328125, 519.9609375, 155.35345458984375], [88.453125, 168.22265625, 131.1300048828125, 178.77154541015625], [148.21875, 185.3533935546875, 521.6200561523438, 303.3533630371094], [149.4140625, 315.3533935546875, 519.9609375, 445.5]]}]"
