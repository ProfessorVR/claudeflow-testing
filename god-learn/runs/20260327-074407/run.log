04809570312, 555.1129150390625], [88.70909881591797, 553.7077026367188, 183.15184020996094, 566.247314453125], [254.04910278320312, 521.16357421875, 348.3417053222656, 567.05712890625]]}, {\"page_num\": 201, \"coords\": [48.3567008972168, 19.831945419311523, 390.77838134765625, 174.509521484375], \"blocks\": [[206.95660400390625, 19.831945419311523, 390.77838134765625, 34.51103210449219], [48.68659973144531, 50.496726989746094, 171.5811004638672, 62.769527435302734], [68.0166015625, 62.143943786621094, 198.616455078125, 96.52953338623047], [225.5166015625, 51.099143981933594, 387.5579833984375, 118.63951873779297], [234.70660400390625, 117.7166976928711, 283.01763916015625, 129.989501953125], [48.3567008972168, 95.31514739990234, 213.6622772216797, 152.09951782226562], [224.19979858398438, 139.6243133544922, 375.80694580078125, 174.509521484375]]}]",
