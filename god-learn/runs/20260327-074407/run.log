    {
      "raw_rank": 8,
      "chunk_id": "746585ac7140c19c:00156",
      "distance": 0.7238017320632935,
      "path_rel": "rhetorical_ontology/Heidegger, Martin - Basic Concepts of Aristotelian Philosophy_(2009)_[Clean Copy].pdf",
