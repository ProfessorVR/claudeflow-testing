      "bboxes": "[{\"page_num\": 118, \"coords\": [69.5989990234375, -0.2780418395996094, 399.8500061035156, 547.1251831054688], \"blocks\": [[69.5989990234375, -0.2780418395996094, 280.8185119628906, 20.74575424194336], [103.6500015258789, 49.10148620605469, 399.8500061035156, 231.59515380859375], [102.75, 532.912841796875, 313.334716796875, 547.1251831054688]]}, {\"page_num\": 119, \"coords\": [28.700000762939453, -0.19952011108398438, 363.0606994628906, 550.9778442382812], \"blocks\": [[271.8500061035156, -0.19952011108398438, 363.0606994628906, 37.036415100097656], [28.700000762939453, 52.163124084472656, 329.3500061035156, 550.9778442382812]]}, {\"page_num\": 120, \"coords\": [39.150001525878906, 1.8146743774414062, 369.3500061035156, 532.1577758789062], \"blocks\": [[39.150001525878906, 1.8146743774414062, 251.21844482421875, 38.00156784057617], [72.9000015258789, 50.289466857910156, 369.3500061035156, 532.1577758789062]]}, {\"page_num\": 121, \"coords\": [36.45000076293945, 11.019710540771484, 364.9396057128906, 533.5648193359375], \"blocks\": [[216.3000030517578, 11.019710540771484, 364.9396057128906, 24.380706787109375], [37.349998474121094, 48.215545654296875, 335.6000061035156, 233.0829620361328], [74.0989990234375, 275.3386535644531, 246.71878051757812, 290.7658996582031], [36.45000076293945, 319.21136474609375, 336.20001220703125, 533.5648193359375]]}]",
