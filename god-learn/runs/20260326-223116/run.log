2.6976623535156, 97.7748031616211], [21.410064697265625, 99.41422271728516, 301.3203430175781, 108.9148178100586], [22.030059814453125, 110.33423614501953, 301.2587890625, 119.83483123779297], [21.840072631835938, 120.7342300415039, 302.9457702636719, 130.23483276367188], [21.630096435546875, 131.3213348388672, 304.34722900390625, 152.5648956298828], [21.840057373046875, 153.52423095703125, 302.6969299316406, 163.02484130859375], [21.840057373046875, 164.51422119140625, 303.2720947265625, 174.01483154296875], [22.060073852539062, 174.54580688476562, 193.13278198242188, 185.42710876464844], [30.920074462890625, 186.57421875, 303.58074951171875, 196.0748291015625], [22.06005859375, 197.17422485351562, 303.2744140625, 207.0262451171875], [21.7900390625, 208.47421264648438, 303.37335205078125, 217.97482299804688], [22.060012817382812, 219.42420959472656, 304.7648010253906, 228.92481994628906], [22.060012817382812, 230.4442138671875, 302.15313720703125, 239.94482421875], [22.490005493164062, 241.66421508789062, 304.1247863769531, 251.16482543945312], [21.899993896484375, 252.6741943359375, 303.87005615234375, 262.1748046875], [22.119979858398438, 262.86041259765625, 329.36676025390625, 275.2552185058594], [21.8399658203125, 273.9721374511719, 304.3310241699219, 284.42486572265625], [21.839935302734375, 285.544189453125, 304.3247375488281, 295.0447998046875], [21.62994384765625, 296.4542236328125, 304.33233642578125, 305.954833984375], [21.6299991607666, 307.1341857910156, 164.95510864257812, 316.8927917480469]]}]",
