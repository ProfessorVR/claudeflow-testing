5, 229.15249633789062], [23.790069580078125, 229.95333862304688, 307.39166259765625, 239.68844604492188], [24.220062255859375, 240.9633331298828, 305.8520202636719, 251.0924835205078], [23.950042724609375, 252.13333129882812, 305.8281555175781, 261.8684387207031], [23.930023193359375, 262.9533386230469, 306.1316223144531, 272.6884460449219], [24.44000244140625, 273.8433532714844, 115.35310363769531, 283.5784606933594], [33.09000778198242, 284.60333251953125, 306.2748107910156, 294.33843994140625], [24.110015869140625, 295.4433288574219, 306.1903991699219, 305.1784362792969]]}]",
