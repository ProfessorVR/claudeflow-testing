      "bboxes": "[{\"page_num\": 284, \"coords\": [42.369998931884766, 315.0699768066406, 356.8999938964844, 591.8759765625], \"blocks\": [[42.369998931884766, 315.0699768066406, 356.8999938964844, 472.3699951171875], [170.89999389648438, 489.0699768066406, 225.8199920654297, 502.3699951171875], [111.80000305175781, 513.22998046875, 284.8499755859375, 526.3699951171875], [42.380001068115234, 531.22998046875, 296.0450134277344, 544.3699951171875], [42.380001068115234, 581.364013671875, 345.3320007324219, 591.8759765625]]}, {\"page_num\": 285, \"coords\": [42.2599983215332, 39.23698806762695, 356.79998779296875, 591.8759765625], \"blocks\": [[42.2599983215332, 39.23698806762695, 235.843994140625, 51.36297607421875], [42.2599983215332, 63.22998809814453, 356.7900085449219, 292.3699951171875], [170.8000030517578, 309.0699768066406, 225.72000122070312, 322.3699951171875], [176.6999969482422, 333.22998046875, 219.8199920654297, 346.3699951171875], [42.2599983215332, 351.22998046875, 356.79998779296875, 496.3699951171875], [42.2599983215332, 527.343994140625, 309.8440246582031, 591.8759765625]]}, {\"page_num\": 286, \"coords\": [42.380001068115234, 39.63701248168945, 356.8999938964844, 286.3699951171875], \"blocks\": [[160.8000030517578, 39.63701248168945, 354.3999938964844, 51.86297607421875], [42.380001068115234, 63.22998809814453, 356.8999938964844, 172.3699951171875], [42.380001068115234, 171.22998046875, 356.8900146484375, 232.3699951171875], [170.89999389648438, 249.0699920654297, 225.8199920654297, 262.3699951171875], [176.8000030517578, 273.22998046875, 219.9199981689453, 286.3699951171875]]}]",
