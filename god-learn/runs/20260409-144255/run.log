      "bboxes": "[{\"page_num\": 53, \"coords\": [19.701461791992188, 390.3909912109375, 335.0, 548.9495239257812], \"blocks\": [[74.4000015258789, 390.3909912109375, 161.1333770751953, 412.8814697265625], [22.39900016784668, 408.1375427246094, 188.91497802734375, 452.21942138671875], [85.75, 472.09466552734375, 112.14336395263672, 479.84063720703125], [36.45000076293945, 484.79742431640625, 137.07223510742188, 499.4261474609375], [19.701461791992188, 402.21728515625, 335.0, 548.9495239257812]]}, {\"page_num\": 54, \"coords\": [91.4000015258789, 12.4409761428833, 390.29998779296875, 545.3268432617188], \"blocks\": [[91.4000015258789, 12.4409761428833, 267.6685791015625, 23.93010139465332], [92.30000305175781, 47.89239501953125, 390.29998779296875, 545.3268432617188]]}, {\"page_num\": 55, \"coords\": [29.89900016784668, 17.942611694335938, 328.45001220703125, 551.5768432617188], \"blocks\": [[275.75, 17.942611694335938, 325.6875, 25.61850929260254], [29.89900016784668, 51.28651809692383, 328.45001220703125, 551.5768432617188]]}, {\"page_num\": 56, \"coords\": [102.44999694824219, 15.84859848022461, 398.6400146484375, 475.43841552734375], \"blocks\": [[102.44999694824219, 15.84859848022461, 277.508544921875, 26.803050994873047], [102.75, 51.233367919921875, 396.8500061035156, 361.6085205078125], [103.05000305175781, 362.2613830566406, 398.6400146484375, 475.43841552734375]]}]",
