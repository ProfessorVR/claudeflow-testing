      "bboxes": "[{\"page_num\": 122, \"coords\": [72.9000015258789, 3.9865455627441406, 398.3500061035156, 547.2083129882812], \"blocks\": [[72.9000015258789, 3.9865455627441406, 279.91851806640625, 28.926271438598633], [129.0500030517578, 306.49163818359375, 289.0, 329.8800964355469], [102.44999694824219, 347.7289123535156, 398.3500061035156, 547.2083129882812]]}, {\"page_num\": 123, \"coords\": [29.299999237060547, 12.823997497558594, 356.6996154785156, 550.5905151367188], \"blocks\": [[207.64999389648438, 12.823997497558594, 356.6996154785156, 25.851484298706055], [39.75, 74.18098449707031, 223.23023986816406, 102.9563980102539], [125.5, 121.68280029296875, 242.93060302734375, 143.97325134277344], [34.349998474121094, 151.24465942382812, 326.5936279296875, 191.35400390625], [108.44999694824219, 188.07406616210938, 247.1299591064453, 210.2100067138672], [64.25, 219.16134643554688, 211.0058135986328, 233.44384765625], [29.299999237060547, 251.53114318847656, 329.3500061035156, 550.5905151367188]]}, {\"page_num\": 124, \"coords\": [137.14999389648438, 487.9953918457031, 261.98150634765625, 502.69232177734375], \"blocks\": [[137.14999389648438, 487.9953918457031, 261.98150634765625, 502.69232177734375]]}, {\"page_num\": 125, \"coords\": [29.600000381469727, -0.3733806610107422, 363.6041259765625, 521.4304809570312], \"blocks\": [[209.75, -0.3733806610107422, 363.6041259765625, 37.85961151123047], [29.600000381469727, 50.33644485473633, 329.04998779296875, 521.4304809570312]]}]",
