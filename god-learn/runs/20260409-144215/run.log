      "bboxes": "[{\"page_num\": 273, \"coords\": [181.9540557861328, 46.25791931152344, 327.25, 539.3154907226562], \"blocks\": [[181.9540557861328, 46.25791931152344, 327.25, 539.3154907226562]]}, {\"page_num\": 274, \"coords\": [32.25, 12.001448631286621, 361.0, 543.4780883789062], \"blocks\": [[32.25, 12.001448631286621, 86.62759399414062, 25.910682678222656], [216.8995361328125, 50.45787048339844, 361.0, 172.9030303955078], [65.75, 52.12714385986328, 202.94000244140625, 284.7301025390625], [61.25, 296.5271301269531, 204.75, 542.91748046875], [214.19000244140625, 184.47714233398438, 360.3900146484375, 543.4780883789062]]}]",
