/**
 * Faceted Retrieval — Per-Facet Evidence Retrieval with Context-Windowed Span Extraction
 *
 * Retrieves evidence organized by facets using SmartRetrievalLayer.
 * Implements two-phase SourceAdmissionPolicy enforcement:
 *   Phase 1 (candidate): allows quotes into verification pool
 *   Phase 2 (eligible): enforced at binding time (in claim-atom-binder)
 *
 * P0 Improvements:
 *   - Intl.Segmenter replaces regex sentence splitting (Unicode-aware)
 *   - Context-aware abbreviation merging (honorific vs citation + uppercase lookahead)
 *   - Greedy non-overlapping context windows (2-3 sentences per span)
 *   - Sentence relevance scoring (term coverage) for core sentence selection
 *   - Negative-pattern noise filter (all-caps, OCR garbage, page headers)
 *   - Cross-facet deduplication by span_fingerprint
 *   - Raised minRelevance default: 0.70
 *
 * @module faceted-retrieval
 */

import { randomUUID } from 'crypto';
import { createHash } from 'crypto';

// Intl.Segmenter type declaration (available in Node 16+, not in ES2022 lib)
declare namespace Intl {
  interface SegmenterOptions {
    localeMatcher?: 'best fit' | 'lookup';
    granularity?: 'grapheme' | 'word' | 'sentence';
  }
  interface SegmentData {
    segment: string;
    index: number;
    input: string;
    isWordLike?: boolean;
  }
  interface Segments {
    [Symbol.iterator](): IterableIterator<SegmentData>;
  }
  class Segmenter {
    constructor(locales?: string | string[], options?: SegmenterOptions);
    segment(input: string): Segments;
  }
}
import type { ContextChunk, RetrievalOptions } from './types.js';
import type { SmartRetrievalLayer } from './smart-retrieval-layer.js';
import type {
  Facet,
  QuoteSpan,
  SourceScopeSpec,
  SourceAdmissionPolicy,
  SourceKind,
  EvidenceStrictness,
  EvidenceScarcityWarning,
  NormalizationPolicy,
  ProvenanceScorecard,
  VerificationStatus,
  PromptSpec,
} from '../core/composition/icp-types.js';
import {
  DEFAULT_NORMALIZATION_POLICY,
} from '../core/composition/icp-types.js';
import {
  normalizeText,
  sha256,
  computeTextFingerprint,
  computeSpanFingerprint,
  computeContextHash,
} from '../core/composition/quote-span-staleness.js';

// =============================================================================
// CONFIGURATION
// =============================================================================

export interface FacetedRetrievalConfig {
  /** Max chunks per facet */
  maxChunksPerFacet?: number;
  /** Min relevance threshold (P0.4: raised from 0.6 to 0.70) */
  minRelevance?: number;
  /** Context window size for span extraction (chars around sentence) */
  contextWindowChars?: number;
  /** Normalization policy */
  normalizationPolicy?: NormalizationPolicy;
  /** Max context windows per chunk (default: 4) */
  maxWindowsPerChunk?: number;
}

const DEFAULT_CONFIG: Required<FacetedRetrievalConfig> = {
  maxChunksPerFacet: 15,
  minRelevance: 0.70,
  contextWindowChars: 40,
  normalizationPolicy: DEFAULT_NORMALIZATION_POLICY,
  maxWindowsPerChunk: 4,
};

// =============================================================================
// SENTENCE SEGMENTATION (P0.1)
// =============================================================================

/** Intl.Segmenter for Unicode-aware sentence boundary detection */
const sentenceSegmenter = new Intl.Segmenter('en', { granularity: 'sentence' });

/** Honorifics: always merge with next segment (Dr. Smith → one sentence) */
const HONORIFICS = new Set([
  'dr', 'prof', 'mr', 'mrs', 'ms', 'rev', 'st', 'jr', 'sr',
]);

/**
 * Citation/reference abbreviations: only merge if next segment starts
 * lowercase or with a number (pp. 221 → merge, but pp. As Nussbaum → split)
 */
const CITATION_ABBREVS = new Set([
  'cf', 'ed', 'eds', 'trans', 'vol', 'vols', 'p', 'pp',
  'viz', 'al', 'vs', 'no', 'ch', 'pt', 'fig', 'repr',
  'op', 'cit', 'ibid', 'sc', 'ca', 'fl', 'approx',
  'e', 'i', // catches e.g. and i.e. if segmenter splits them
]);

interface Sentence {
  text: string;
  start: number;
  end: number;
}

/**
 * P0.1: Segment text into sentences using Intl.Segmenter with
 * context-aware abbreviation merging.
 *
 * Uses a two-category merge strategy:
 * - Honorifics (Dr., Prof.): always merge with next segment
 * - Citation abbrevs (pp., cf., ed.): merge only if next starts lowercase/number
 */
function segmentSentences(text: string): Sentence[] {
  const rawSegments = Array.from(sentenceSegmenter.segment(text))
    .filter(s => s.segment.trim().length > 0)
    .map(s => ({
      text: s.segment.trim(),
      start: s.index,
      end: s.index + s.segment.length,
    }));

  const merged: Sentence[] = [];
  let current: Sentence | null = null;

  for (let i = 0; i < rawSegments.length; i++) {
    const seg = rawSegments[i];

    if (current === null) {
      current = { text: seg.text, start: seg.start, end: seg.end };
    } else {
      current.text = current.text + ' ' + seg.text;
      current.end = seg.end;
    }

    // Check if current segment ends with a known abbreviation
    const match = current.text.match(/\b([a-zA-Z]+)\.$/);

    if (match && i < rawSegments.length - 1) {
      const word = match[1].toLowerCase();
      const nextSeg = rawSegments[i + 1];
      const nextStartsUpper = /^[A-Z]/.test(nextSeg.text);

      const isHonorific = HONORIFICS.has(word);
      const isCitationAbbrev = CITATION_ABBREVS.has(word);

      // Honorifics: always merge (Dr. Smith)
      // Citation abbrevs: merge only if next starts lowercase/number (pp. 221)
      if (isHonorific || (isCitationAbbrev && !nextStartsUpper)) {
        continue; // hold current, append next in next iteration
      }
    }

    merged.push(current);
    current = null;
  }

  // Flush remaining
  if (current !== null) {
    merged.push(current);
  }

  // If no sentences found, use the whole text as one sentence
  if (merged.length === 0 && text.trim().length > 0) {
    merged.push({ text: text.trim(), start: 0, end: text.length });
  }

  return merged;
}

// =============================================================================
// NOISE FILTER (P0.6)
// =============================================================================

/**
 * P0.6: Negative-pattern noise filter.
 * Returns true if the sentence is noise that should be excluded from
 * core sentence selection (all-caps headers, OCR garbage, page numbers).
 */
function isNoise(sentence: string): boolean {
  // All-caps text (section headers, running headers)
  if (sentence.length > 3 && /^[^a-z]*$/.test(sentence)) return true;

  // >50% non-alphabetic characters (OCR garbage, tables, formulas)
  const nonAlpha = sentence.match(/[^a-zA-Z\s]/g);
  if (nonAlpha && nonAlpha.length > sentence.length * 0.5) return true;

  // Standalone page headers/numbers (must be entire sentence)
  if (/^(Chapter\s+\d+|\d+)\s*$/i.test(sentence)) return true;

  return false;
}

// =============================================================================
// FACET RETRIEVAL RESULT
// =============================================================================

export interface FacetRetrievalResult {
  facet_id: string;
  /** Quote spans extracted from this facet's retrieval */
  spans: QuoteSpan[];
  /** Raw chunks retrieved (for context) */
  chunks: ContextChunk[];
  /** Coverage stats */
  coverage: FacetCoverage;
  /** Scarcity warnings */
  scarcity_warnings: EvidenceScarcityWarning[];
}

export interface FacetCoverage {
  total_spans: number;
  verified_span_count: number;
  definitional_span_count: number;
  distinct_documents: number;
}

// =============================================================================
// FACETED RETRIEVAL ENGINE
// =============================================================================

export class FacetedRetrieval {
  private readonly retrieval: SmartRetrievalLayer;
  private readonly config: Required<FacetedRetrievalConfig>;

  constructor(
    retrieval: SmartRetrievalLayer,
    config: FacetedRetrievalConfig = {},
  ) {
    this.retrieval = retrieval;
    this.config = { ...DEFAULT_CONFIG, ...config };
  }

  /**
   * Retrieve evidence for all facets in a PromptSpec.
   * P0.5: Applies cross-facet deduplication by span_fingerprint after
   * collecting spans from all facets, keeping the instance with the
   * highest fidelity_score.
   */
  async retrieveForAllFacets(
    promptSpec: PromptSpec,
    sourceScope: SourceScopeSpec,
    admissionPolicy?: SourceAdmissionPolicy,
  ): Promise<FacetRetrievalResult[]> {
    const results: FacetRetrievalResult[] = [];

    const allFacets = [...promptSpec.required_facets, ...promptSpec.optional_facets];

    for (const facet of allFacets) {
      const terms = promptSpec.retrieval_lexicon.get(facet.facet_id) ?? [];
      const result = await this.retrieveForFacet(
        facet,
        terms,
        sourceScope,
        admissionPolicy,
      );
      results.push(result);
    }

    // P0.5: Cross-facet deduplication
    // Track the best instance of each span_fingerprint across all facets
    const bestByFingerprint = new Map<string, { span: QuoteSpan; facetIdx: number }>();

    for (let fi = 0; fi < results.length; fi++) {
      for (const span of results[fi].spans) {
        const existing = bestByFingerprint.get(span.span_fingerprint);
        if (!existing || span.provenance_scorecard.fidelity_score > existing.span.provenance_scorecard.fidelity_score) {
          bestByFingerprint.set(span.span_fingerprint, { span, facetIdx: fi });
        }
      }
    }

    // Rebuild each facet's span list with only unique spans (no cross-facet dupes)
    const usedFingerprints = new Set<string>();
    for (const result of results) {
      result.spans = result.spans.filter(span => {
        const best = bestByFingerprint.get(span.span_fingerprint);
        // Keep this span only if it's the best instance AND not already used
        if (best && best.span.quote_id === span.quote_id && !usedFingerprints.has(span.span_fingerprint)) {
          usedFingerprints.add(span.span_fingerprint);
          return true;
        }
        return false;
      });
      // Recompute coverage after dedup
      result.coverage = this.computeCoverage(result.spans);
    }

    return results;
  }

  /**
   * Retrieve evidence for a single facet.
   *
   * Uses SourceScopeSpec.corpus_config for collection filtering,
   * relevance thresholds, and chunk limits. Employs hybrid search
   * (semantic + keyword) with per-collection parallel retrieval.
   */
  async retrieveForFacet(
    facet: Facet,
    retrievalTerms: string[],
    sourceScope: SourceScopeSpec,
    admissionPolicy?: SourceAdmissionPolicy,
  ): Promise<FacetRetrievalResult> {
    const query = this.buildSemanticQuery(facet, retrievalTerms);
    const corpusConfig = sourceScope.corpus_config;
    const minRelevance = corpusConfig?.min_relevance ?? this.config.minRelevance;
    const maxChunks = corpusConfig?.max_chunks ?? this.config.maxChunksPerFacet;
    const collections = corpusConfig?.collections;

    // Retrieve chunks using hybrid search with per-collection parallel retrieval
    let chunks: ContextChunk[];

    if (collections && collections.length > 0) {
      // Per-collection parallel retrieval (mirrors SectionOrchestrator pattern)
      const chunksPerCollection = Math.ceil(maxChunks / collections.length);
      const retrievalPromises = collections.map(async (collection) => {
        try {
          return await this.retrieval.retrieveContext(query, {
            maxChunks: chunksPerCollection,
            minRelevance,
            collections: [collection],
            diversityBoost: true,
          });
        } catch {
          // Individual collection failure is non-fatal
          return [];
        }
      });
      const allResults = await Promise.all(retrievalPromises);
      // Flatten, deduplicate by docId+page, sort by relevance, limit
      const flatResults = allResults.flat();
      const seen = new Set<string>();
      chunks = flatResults
        .filter(chunk => {
          const key = `${chunk.docId}:${chunk.metadata.page_start}`;
          if (seen.has(key)) return false;
          seen.add(key);
          return chunk.relevanceScore >= minRelevance;
        })
        .sort((a, b) => b.relevanceScore - a.relevanceScore)
        .slice(0, maxChunks);
    } else {
      // Fallback: hybrid search without collection filtering
      try {
        chunks = await this.retrieval.hybridSearch(
          query,
          retrievalTerms,
          { semantic: 0.7, keyword: 0.3 },
        );
        chunks = chunks
          .filter(c => c.relevanceScore >= minRelevance)
          .slice(0, maxChunks);
      } catch {
        // Final fallback: basic semantic search
        chunks = await this.retrieval.retrieveContext(query, {
          maxChunks,
          minRelevance,
        });
      }
    }

    // P0.2: Extract context-windowed spans from chunks
    const spans: QuoteSpan[] = [];
    for (const chunk of chunks) {
      const extracted = this.extractWindowedSpans(chunk, facet, retrievalTerms);
      // Apply candidate-phase admission if policy exists
      const admitted = admissionPolicy
        ? this.applyCandidateAdmission(extracted, facet, admissionPolicy)
        : extracted;
      spans.push(...admitted);
    }

    // Compute coverage
    const coverage = this.computeCoverage(spans);

    // Check for scarcity
    const scarcityWarnings = this.checkScarcity(
      facet,
      coverage,
      facet.strictness_override ?? 'strict',
    );

    return {
      facet_id: facet.facet_id,
      spans,
      chunks,
      coverage,
      scarcity_warnings: scarcityWarnings,
    };
  }

  // ===========================================================================
  // P0.2: CONTEXT-WINDOWED SPAN EXTRACTION
  // ===========================================================================

  /**
   * Extract context-windowed QuoteSpans from a chunk.
   *
   * Uses greedy non-overlapping window selection:
   * 1. Segment text into sentences (Intl.Segmenter + abbreviation merge)
   * 2. Score each sentence for relevance to facet terms
   * 3. Sort candidates by score descending
   * 4. Greedily build 3-sentence windows, marking indices as used
   * 5. Cap at maxWindowsPerChunk to prevent UI bloat
   *
   * Each window's text = context_before + core_text + context_after.
   * Orphan fragments (<30 chars) are disqualified from core selection
   * but absorbed as context in adjacent windows.
   */
  private extractWindowedSpans(
    chunk: ContextChunk,
    facet: Facet,
    retrievalTerms: string[],
  ): QuoteSpan[] {
    const text = chunk.content;
    const sourceKind: SourceKind = (chunk.metadata as any).source_kind ?? 'CORPUS';
    const policy = this.config.normalizationPolicy;

    // Step 1: Segment into sentences
    const sentences = segmentSentences(text);
    if (sentences.length === 0) return [];

    // Step 2: Score each sentence
    const scored = sentences.map((sentence, index) => {
      const isOrphan = sentence.text.length < 30;
      const noisy = isNoise(sentence.text);
      // Orphans and noise score 0 — never selected as core
      const score = (isOrphan || noisy)
        ? 0
        : this.scoreSentenceRelevance(sentence.text, retrievalTerms);
      return { sentence, index, score };
    });

    // Step 3: Sort candidates by score descending (only those with score > 0)
    const candidates = scored
      .filter(s => s.score > 0)
      .sort((a, b) => b.score - a.score);

    // Step 4: Greedy non-overlapping window selection
    const usedIndices = new Set<number>();
    const windows: Array<{
      coreIndex: number;
      coreScore: number;
      startIndex: number;
      endIndex: number;
    }> = [];

    for (const candidate of candidates) {
      if (windows.length >= this.config.maxWindowsPerChunk) break;

      const ci = candidate.index;
      const windowStart = Math.max(0, ci - 1);
      const windowEnd = Math.min(sentences.length - 1, ci + 1);

      // Check for overlap with already-used indices
      let overlaps = false;
      for (let idx = windowStart; idx <= windowEnd; idx++) {
        if (usedIndices.has(idx)) { overlaps = true; break; }
      }
      if (overlaps) continue;

      // Mark indices as used
      for (let idx = windowStart; idx <= windowEnd; idx++) {
        usedIndices.add(idx);
      }

      windows.push({
        coreIndex: ci,
        coreScore: candidate.score,
        startIndex: windowStart,
        endIndex: windowEnd,
      });
    }

    // Step 5: Build QuoteSpans from windows
    const spans: QuoteSpan[] = [];

    for (const win of windows) {
      // Assemble window text and parts
      const windowSentences = sentences.slice(win.startIndex, win.endIndex + 1);
      const fullText = windowSentences.map(s => s.text).join(' ');
      const coreSentence = sentences[win.coreIndex];

      const contextBeforeParts = sentences.slice(win.startIndex, win.coreIndex);
      const contextAfterParts = sentences.slice(win.coreIndex + 1, win.endIndex + 1);
      const contextBefore = contextBeforeParts.map(s => s.text).join(' ');
      const contextAfter = contextAfterParts.map(s => s.text).join(' ');

      // Use the window's character range for fingerprinting
      const windowStart = windowSentences[0].start;
      const windowEnd = windowSentences[windowSentences.length - 1].end;

      // Compute fingerprints based on full window text
      const textFingerprint = computeTextFingerprint(fullText, policy);
      const leftCtxHash = this.computeSentenceContextHash(
        text,
        windowStart,
        windowEnd,
        'left',
        policy,
      );
      const rightCtxHash = this.computeSentenceContextHash(
        text,
        windowStart,
        windowEnd,
        'right',
        policy,
      );
      const spanFingerprint = computeSpanFingerprint(
        chunk.docId,
        textFingerprint,
        leftCtxHash,
        rightCtxHash,
      );

      const span: QuoteSpan = {
        quote_id: randomUUID(),
        text_fingerprint: textFingerprint,
        span_fingerprint: spanFingerprint,
        doc_id: chunk.docId,
        page: chunk.metadata.page_start,
        source_kind: sourceKind,
        clean_text_range: [windowStart, windowEnd],
        clean_range_hash: sha256(text.slice(windowStart, windowEnd)),
        patch_epoch: 0,
        normalization_policy_version: policy.version,
        text: fullText,
        left_ctx_hash: leftCtxHash,
        right_ctx_hash: rightCtxHash,
        verification_status: 'flagged',
        provenance_scorecard: this.buildProvenanceScorecard(chunk, fullText),
        // P0.3: Context window formatting boundaries
        core_text: coreSentence.text,
        context_before: contextBefore || undefined,
        context_after: contextAfter || undefined,
        core_relevance_score: win.coreScore,
      };

      if (chunk.metadata.page_start) {
        span.source_anchor = `p. ${chunk.metadata.page_start}`;
      }

      spans.push(span);
    }

    // Fallback: if no windows were created (all sentences were noise/orphans),
    // create a single span from the full chunk text
    if (spans.length === 0 && text.trim().length >= 30) {
      const textFingerprint = computeTextFingerprint(text, policy);
      const leftCtxHash = computeContextHash(text, [0, text.length], 'left', policy, this.config.contextWindowChars);
      const rightCtxHash = computeContextHash(text, [0, text.length], 'right', policy, this.config.contextWindowChars);
      const spanFingerprint = computeSpanFingerprint(chunk.docId, textFingerprint, leftCtxHash, rightCtxHash);

      spans.push({
        quote_id: randomUUID(),
        text_fingerprint: textFingerprint,
        span_fingerprint: spanFingerprint,
        doc_id: chunk.docId,
        page: chunk.metadata.page_start,
        source_kind: sourceKind,
        clean_text_range: [0, text.length],
        clean_range_hash: sha256(text),
        patch_epoch: 0,
        normalization_policy_version: policy.version,
        text: text.trim(),
        left_ctx_hash: leftCtxHash,
        right_ctx_hash: rightCtxHash,
        verification_status: 'flagged',
        provenance_scorecard: this.buildProvenanceScorecard(chunk, text),
      });
    }

    return spans;
  }

  // ===========================================================================
  // SENTENCE RELEVANCE SCORING
  // ===========================================================================

  /**
   * Score a sentence's relevance to facet retrieval terms.
   * Returns 0-1 based on the proportion of terms found in the sentence.
   *
   * This is a lightweight heuristic for selecting the core sentence within
   * a chunk that is already known to be semantically relevant.
   * P1 will replace this with embedding-based scoring.
   */
  private scoreSentenceRelevance(sentence: string, terms: string[]): number {
    if (terms.length === 0) return 0;
    const lower = sentence.toLowerCase();
    let matchCount = 0;
    for (const term of terms) {
      if (lower.includes(term.toLowerCase())) matchCount++;
    }
    return matchCount / terms.length;
  }

  // ===========================================================================
  // QUERY BUILDING
  // ===========================================================================

  /**
   * Build a natural language query from facet metadata for semantic search.
   * Uses the facet description (rich semantic signal) when available,
   * falling back to name + terms for keyword-extracted facets.
   */
  private buildSemanticQuery(facet: Facet, retrievalTerms: string[]): string {
    // Prefer description: it contains a natural language research question
    // that produces a semantically rich embedding
    if (facet.description && facet.description.length > 30) {
      return facet.description;
    }
    // Fall back to structured query: "facet name: term1, term2, term3"
    if (facet.name && retrievalTerms.length > 0) {
      return `${facet.name}: ${retrievalTerms.join(', ')}`;
    }
    // Last resort: space-joined terms (original behavior)
    return retrievalTerms.join(' ');
  }

  // ===========================================================================
  // FINGERPRINTING HELPERS
  // ===========================================================================

  /**
   * Compute context hash for a sentence/window within chunk text.
   */
  private computeSentenceContextHash(
    chunkText: string,
    rangeStart: number,
    rangeEnd: number,
    side: 'left' | 'right',
    policy: NormalizationPolicy,
  ): string {
    return computeContextHash(
      chunkText,
      [rangeStart, rangeEnd],
      side,
      policy,
      this.config.contextWindowChars,
    );
  }

  // ===========================================================================
  // PROVENANCE & QUALITY
  // ===========================================================================

  /**
   * Build ProvenanceScorecard for a quote span.
   */
  private buildProvenanceScorecard(
    chunk: ContextChunk,
    quoteText: string,
  ): ProvenanceScorecard {
    return {
      fidelity_score: chunk.relevanceScore,
      ocr_risk_score: this.estimateOCRRisk(quoteText),
      cluster_size: 1,
      prior_usage_count: 0,
      doc_authority_tier: this.estimateAuthorityTier(chunk),
    };
  }

  /**
   * Estimate OCR risk from text characteristics.
   */
  private estimateOCRRisk(text: string): number {
    let risk = 0;

    // Check for common OCR artifacts
    if (/[ﬁﬂﬃﬄ]/.test(text)) risk += 0.2; // Ligatures
    if (/\w-\s*\n\s*\w/.test(text)) risk += 0.15; // Hyphenated line breaks
    if (/[^\x20-\x7E\u00C0-\u024F\u0370-\u03FF]/.test(text)) risk += 0.1; // Unusual chars
    if (text.length < 30) risk += 0.1; // Short quotes are riskier

    return Math.min(1.0, risk);
  }

  /**
   * Estimate authority tier from chunk metadata.
   */
  private estimateAuthorityTier(chunk: ContextChunk): number {
    const collection = chunk.metadata.collection?.toLowerCase() ?? '';
    if (collection.includes('primary') || collection.includes('ancient')) return 1;
    if (collection.includes('peer') || collection.includes('journal')) return 1;
    if (collection.includes('monograph') || collection.includes('book')) return 2;
    if (collection.includes('conference')) return 3;
    return 2; // Default to monograph tier
  }

  // ===========================================================================
  // ADMISSION POLICY
  // ===========================================================================

  /**
   * Apply candidate-phase admission rules.
   * This is the minimal bar to reach the verification UI.
   */
  private applyCandidateAdmission(
    spans: QuoteSpan[],
    facet: Facet,
    policy: SourceAdmissionPolicy,
  ): QuoteSpan[] {
    const strictness = facet.strictness_override ?? 'strict';

    return spans.filter(span => {
      const rules = policy.candidate_rules.filter(
        r => r.source_kind === span.source_kind && r.strictness === strictness,
      );

      if (rules.length === 0) {
        // No matching rule — default: allow corpus, allow external if not auto_rejected
        if (span.source_kind === 'CORPUS') return true;
        return span.verification_status !== 'auto_rejected';
      }

      // Check if span meets candidate rules
      return rules.some(rule => {
        if (rule.min_authority_tier !== undefined) {
          if (span.provenance_scorecard.doc_authority_tier > rule.min_authority_tier) {
            return false;
          }
        }
        // Candidate phase doesn't check verification status strictly
        // (spans haven't been verified yet)
        return true;
      });
    });
  }

  // ===========================================================================
  // COVERAGE & SCARCITY
  // ===========================================================================

  /**
   * Compute coverage stats for a set of spans.
   */
  private computeCoverage(spans: QuoteSpan[]): FacetCoverage {
    const docs = new Set(spans.map(s => s.doc_id));
    const verified = spans.filter(s =>
      s.verification_status === 'auto_verified' ||
      s.verification_status === 'human_verified' ||
      s.verification_status === 'human_corrected',
    );

    // Heuristic: definitional spans contain "is" or "means" or "defines"
    const definitional = spans.filter(s =>
      /\b(is|are|means?|defines?|denotes?|refers?\s+to)\b/i.test(s.text),
    );

    return {
      total_spans: spans.length,
      verified_span_count: verified.length,
      definitional_span_count: definitional.length,
      distinct_documents: docs.size,
    };
  }

  /**
   * Check for evidence scarcity and emit warnings.
   */
  private checkScarcity(
    facet: Facet,
    coverage: FacetCoverage,
    strictness: EvidenceStrictness,
  ): EvidenceScarcityWarning[] {
    const warnings: EvidenceScarcityWarning[] = [];

    if (coverage.total_spans === 0) {
      warnings.push({
        facet_id: facet.facet_id,
        warning_type: 'low_span_count',
        details: `Facet "${facet.name}" has no evidence spans`,
      });
      return warnings;
    }

    if (strictness === 'strict') {
      if (coverage.total_spans < 2) {
        warnings.push({
          facet_id: facet.facet_id,
          warning_type: 'low_span_count',
          details: `Facet "${facet.name}" has only ${coverage.total_spans} span(s); strict mode requires >= 2`,
        });
      }

      if (coverage.definitional_span_count === 0 && facet.facet_role === 'core') {
        warnings.push({
          facet_id: facet.facet_id,
          warning_type: 'no_definitional_spans',
          details: `Core facet "${facet.name}" has no definitional spans`,
        });
      }

      if (coverage.distinct_documents < 2) {
        warnings.push({
          facet_id: facet.facet_id,
          warning_type: 'single_document',
          details: `Facet "${facet.name}" sources from only ${coverage.distinct_documents} document(s); strict mode requires >= 2`,
        });
      }
    }

    return warnings;
  }
}
