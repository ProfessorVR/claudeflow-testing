      const traceLines = session.event_log
        .filter(e => e.user_visible)
        .map(e => `[${e.ts}] ${e.actor}/${e.action}: ${e.payload_summary}`);

      // Serialize prompt_spec Maps for JSON export
      const serializedPromptSpec = {
