  // =========================================================================
  // EVIDENCE ENDPOINTS
  // =========================================================================

  /**
   * POST /api/icp/retrieve/:sessionId — Trigger faceted retrieval
   * Body: { facetIds?: string[] }
   *
   * Runs retrieval for the session using current (non-archived) facets.
   * Respects user edits: archived facets are excluded, custom facets included.
   * Also runs canonicalization + auto-verification on new spans.
   */
  router.post('/retrieve/:sessionId', async (req: Request, res: Response) => {
    try {
      const session = getSession(req.params.sessionId, res);
      if (!session) return;

      // Build a promptSpec that reflects the session's current facets (not the original decomposition)
      const activeFacets = session.facets.filter(f => !f.archived);
      const effectivePromptSpec: PromptSpec = {
        ...session.prompt_spec,
        required_facets: activeFacets.filter(f => f.facet_role === 'core'),
        optional_facets: activeFacets.filter(f => f.facet_role !== 'core'),
      };

      const factory = await getFactoryResult(session.corpus_folder);
      const facetedRetrieval = new FacetedRetrieval(factory.deps.retrieval);
      const retrievalResults = await facetedRetrieval.retrieveForAllFacets(
        effectivePromptSpec,
        session.source_scope,
        undefined,
        session.source_priority ?? undefined,
      );

      const newSpans: QuoteSpan[] = [];
      for (const result of retrievalResults) {
        newSpans.push(...result.spans);
        emitRetrievalEvent(session, result.facet_id, result.spans.length);
      }

      // Deduplicate: only add spans not already in the session
      const existingFingerprints = new Set(session.quote_spans.map(s => s.span_fingerprint));
      const uniqueNewSpans = newSpans.filter(s => !existingFingerprints.has(s.span_fingerprint));
      session.quote_spans.push(...uniqueNewSpans);

      // Re-rank all spans
      if (session.quote_spans.length > 0) {
        const ranker = new QuoteRanker();
        const { ranked, activeSet } = ranker.canonicalizeAndRank(
          session.quote_spans,
          session.facets,
        );
        session.quote_spans = ranked;
        session.active_quote_set = activeSet;
      }

      // Auto-verify new spans
      if (uniqueNewSpans.length > 0) {
        const verifier = new AutoVerifier(factory.orchestratorConfig.autoVerifierConfig);
        const spansByDoc = new Map<string, QuoteSpan[]>();
        for (const span of uniqueNewSpans) {
          if (!spansByDoc.has(span.doc_id)) spansByDoc.set(span.doc_id, []);
          spansByDoc.get(span.doc_id)!.push(span);
        }
        for (const [_docId, docSpans] of spansByDoc) {
          const cleanText = docSpans.map(s => s.text).join(' ');
          const results = await verifier.verifyBatch(docSpans, cleanText, session.canonical_registry_snapshot);
          verifier.applyResults(docSpans, results);
          for (const [quoteId, result] of results) {
            emitVerificationEvent(session, quoteId, result.recommended_status);
          }
        }
      }

      res.json({
        sessionId: req.params.sessionId,
        quote_spans: session.quote_spans,
        total: session.quote_spans.length,
        new_spans: uniqueNewSpans.length,
      });
    } catch (error: any) {
      log.error('Failed to retrieve', error);
      res.status(500).json({ error: 'Failed to retrieve', details: error.message });
    }
  });

  /**
   * POST /api/icp/continue/:sessionId — Run stages 5-7 on an existing session
   *
   * Stages:
   *   5. Claims (via claimProvider)
   *   6. Atom decomposition + binding
   *   6.5. Writing contract
   *   7. Stress test
   *
   * Requires the session to already have quote_spans (from evidence retrieval).
   */
  router.post('/continue/:sessionId', async (req: Request, res: Response) => {
    try {
      const session = getSession(req.params.sessionId, res);
      if (!session) return;

      if (session.quote_spans.length === 0) {
        res.status(400).json({ error: 'No evidence in session. Retrieve evidence first.' });
        return;
      }

      log.info('Continuing pipeline: stages 5-7', {
        sessionId: req.params.sessionId,
        spans: session.quote_spans.length,
      });

      const factory = await getFactoryResult(session.corpus_folder);
      const atomBinder = new ClaimAtomBinder();
      const contractBuilder = new WritingContractBuilder();
      const stressTester = new ClaimStressTester({}, factory.deps.retrieval);

      // Stage 5: Claims
      type ToulminClaim = import('../../cli/composition/sir/claim-map.js').ToulminClaim;
      type ClaimMap = import('../../cli/composition/sir/claim-map.js').ClaimMap;
      let claims: ToulminClaim[] = [];
      let claimMap: ClaimMap | undefined;

      if (factory.deps.claimProvider) {
        const claimResult = await factory.deps.claimProvider(
          session.prompt_spec,
          session.quote_spans,
          session.source_priority ?? undefined,
        );
        claims = claimResult.claims;
        claimMap = claimResult.claimMap;
        session.claim_map = claimMap;
      }

      // Stage 6: Atom Decomposition + Binding
      const allBlockReasons: Array<{ facet_id: string; reason: string }> = [];
      if (claims.length > 0) {
        for (const facet of session.facets) {
          if (facet.archived) continue;

          const { atoms } = atomBinder.decompose(claims, facet.facet_id);
          session.atoms.push(...atoms);

          const { bindings, unbound_atoms, block_reasons } = atomBinder.bind(
            atoms,
            session.quote_spans,
            session.facets,
          );
          session.bindings.push(...bindings);
          allBlockReasons.push(...block_reasons);

          // Demote unbound atoms to hypothesis claims
          if (unbound_atoms.length > 0) {
            const hypotheses = atomBinder.demoteToHypothesis(unbound_atoms, claims, bindings);
            session.hypothesis_claims.push(...hypotheses);
          }
        }
      }

      // Stage 6.5: Writing contract
      const contractResult = contractBuilder.build(
        session.prompt_spec.original_prompt,
        'Full scope',
        session.facets,
        session.quote_spans,
        session.atoms,
        session.bindings,
      );
      session.writing_contract = contractResult.contract;

      // Stage 7: Stress test
      if (claims.length > 0) {
        const stressReport = await stressTester.stressTest(
          session.atoms,
          session.bindings,
          session.quote_spans,
          claims,
        );
        session.stress_test_report = stressReport;

        emitStressTestEvent(
          session,
          stressReport.summary.total_tested,
          stressReport.summary.passed,
          stressReport.summary.failed,
          stressReport.summary.demoted,
        );
      }

      log.info('Continue pipeline complete', {
        sessionId: req.params.sessionId,
        claims: claims.length,
        atoms: session.atoms.length,
        bindings: session.bindings.length,
        hypotheses: session.hypothesis_claims.length,
      });

      res.json({
        sessionId: req.params.sessionId,
        session: serializeSession(session),
        stages: {
          claims: claims.length,
          atoms: session.atoms.length,
          bindings: session.bindings.length,
          hypotheses: session.hypothesis_claims.length,
          blockReasons: allBlockReasons.length,
          stressTest: session.stress_test_report ? {
            tested: session.stress_test_report.summary.total_tested,
            passed: session.stress_test_report.summary.passed,
            failed: session.stress_test_report.summary.failed,
          } : null,
        },
      });
    } catch (error: any) {
      log.error('Failed to continue pipeline', error);
      res.status(500).json({ error: 'Failed to continue pipeline', details: error.message });
    }
  });

  /**
   * POST /api/icp/generate-prose/:sessionId — Run stages 8-11 on an existing session
   *
   * Stages:
   *   8. Paragraph plan → validate → constrained generation
   *   9. (Citation enforcement skipped — requires corpus constraint from full pipeline)
   *  10. Quality summary + endnotes
   *  11. Export package
   *
   * Requires the session to already have atoms + bindings (from stages 5-7).
   */
  router.post('/generate-prose/:sessionId', async (req: Request, res: Response) => {
    try {
      const session = getSession(req.params.sessionId, res);
      if (!session) return;

      if (session.atoms.length === 0 || session.bindings.length === 0) {
        res.status(400).json({ error: 'No atoms or bindings. Run stages 5-7 first.' });
        return;
      }

      log.info('Generating prose: stages 8-11', {
        sessionId: req.params.sessionId,
        atoms: session.atoms.length,
        bindings: session.bindings.length,
      });

      const factory = await getFactoryResult(session.corpus_folder);
      const generator = new ConstrainedGenerator();
      const defaultAtomsMode = 'analytics';
      const defaultReverseCheckMode = 'warn';

      // Stage 8: Paragraph Plan
      let plan: ParagraphPlanEntry[];
      try {
        plan = await factory.deps.generationProvider.generateParagraphPlan(
          session.atoms,
          session.bindings,
        );
      } catch (planErr: any) {
        log.warn('Paragraph plan failed, using fallback', { error: planErr.message });
        // Fallback: one paragraph per facet
        const activeFacets = session.facets.filter(f => !f.archived);
        plan = activeFacets.map((facet, idx) => {
          const facetAtomIds = session.atoms
            .filter(a => a.facet_id === facet.facet_id)
            .map(a => a.atom_id);
          return {
            paragraph_id: `para_${idx}`,
            paragraph_order: idx,
            atom_ids: facetAtomIds,
            topic_sentence_hint: facet.name,
          };
        }).filter(p => p.atom_ids.length > 0);
      }

      session.paragraph_plan = plan;

      // Validate plan
      const validation = generator.validatePlan(
        plan,
        session.atoms,
        session.bindings,
        session.facets,
        defaultAtomsMode,
      );

      emitPlanValidateEvent(session, validation.valid, validation.errors);

      // Load style prompt
      let stylePrompt: string | undefined;
      try {
        const mgr = getStyleManager();
        stylePrompt = mgr.generateStylePrompt(session.style_profile_id || undefined) ?? undefined;
      } catch { /* non-fatal */ }
      if (!stylePrompt && session.style_prompt) {
        stylePrompt = session.style_prompt;
      }

      // Generate prose
      if (validation.valid || defaultAtomsMode !== 'strict') {
        const generationResult = await generator.generate(
          plan,
          session.atoms,
          session.bindings,
          session.quote_spans,
          session.facets,
          defaultAtomsMode,
          defaultReverseCheckMode,
          factory.deps.generationProvider,
          stylePrompt,
        );

        for (const para of generationResult.paragraphs) {
          session.generated_text.set(para.paragraph_id, para.text);
          session.sentence_scopes.push(...para.sentences);
          emitGenerationEvent(session, para.paragraph_id, para.drift_flags.length);
        }

        session.paragraph_ledger = generationResult.ledger;
      }

      // Assemble final prose
      const orderedParagraphs = session.paragraph_plan
        .sort((a, b) => a.paragraph_order - b.paragraph_order)
        .map(p => session.generated_text.get(p.paragraph_id))
        .filter((text): text is string => !!text);
      let assembledProse = orderedParagraphs.join('\n\n');

      // Stage 10: Endnotes
      let endnotesSection = '';
      try {
        const endnoteGen = new EndnoteGenerator({
          maxQuotationsPerEndnote: 3,
          minRelevanceThreshold: 0.65,
        });
        const corpusSearchFn: CorpusSearchFn = async (query, limit) => {
          try {
            const results = await factory.deps.retrieval.retrieveContext(query, { maxChunks: limit });
            return results.map((r: any) => ({
              id: r.chunkId ?? r.id ?? '',
              text: r.content ?? '',
              metadata: r.metadata ?? {},
              score: r.relevanceScore ?? 0,
            }));
          } catch { return []; }
        };
        const endnoteResult = await endnoteGen.generateEndnotes(assembledProse, corpusSearchFn);
        assembledProse = endnoteResult.contentWithMarkers;
        endnotesSection = endnoteResult.endnotesSection;
      } catch { /* non-fatal */ }

      // Stage 11: Export package
      const manifestBuilder = new RunManifestBuilder({});
      const manifest = manifestBuilder.snapshot(session, 'interactive');
      session.run_manifest = manifest;

      const exportPackage = manifestBuilder.buildExportPackage(
        session,
        manifest,
        assembledProse,
      );
      if (endnotesSection) exportPackage.endnotes = endnotesSection;

      emitExportEvent(session, manifest.run_id, 'markdown');

      // Populate quality_gates summary
      session.quality_gates = {
        endnotes: endnotesSection ? {
          total: (endnotesSection.match(/^\d+\./gm) ?? []).length,
          supporting_quotations: 0,
          sources_used: [],
        } : undefined,
        sanitization: { artifacts_removed: 0, passes: 0 },
        style_profile: stylePrompt ? {
          id: session.style_profile_id ?? 'default',
          applied: true,
        } : undefined,
        checkpoints: ['binding_complete', 'generation_complete'],
      };

      const wordCount = assembledProse.split(/\s+/).filter(Boolean).length;

      log.info('Generate prose complete', {
        sessionId: req.params.sessionId,
        paragraphs: session.paragraph_plan.length,
        wordCount,
      });

      res.json({
        sessionId: req.params.sessionId,
        session: serializeSession(session),
        exportPackage: {
          final_prose: exportPackage.final_prose,
          endnotes: exportPackage.endnotes,
          bibliography: exportPackage.bibliography,
          word_count: wordCount,
        },
      });
    } catch (error: any) {
      log.error('Failed to generate prose', error);
      res.status(500).json({ error: 'Failed to generate prose', details: error.message });
    }
  });

  /**
   * POST /api/icp/run-gauntlet/:sessionId — Run the 7-stage Quality Gauntlet
   *
   * Evaluates the session's generated prose through:
   *   citation-verifier, toulmin-enforcer, argument-coherence,
   *   citation-completeness, citation-density, style-consistency, factual-accuracy
   *
   * Requires generated text in the session (from stages 8-11 or full pipeline).
   */
  router.post('/run-gauntlet/:sessionId', async (req: Request, res: Response) => {
    try {
      const session = getSession(req.params.sessionId, res);
      if (!session) return;

      // Assemble prose from generated text
      const orderedParagraphs = session.paragraph_plan
        .sort((a, b) => a.paragraph_order - b.paragraph_order)
        .map(p => session.generated_text.get(p.paragraph_id))
        .filter((text): text is string => !!text);
      const assembledProse = orderedParagraphs.join('\n\n');

      if (!assembledProse || assembledProse.trim().length === 0) {
        res.status(400).json({ error: 'No generated prose in session. Run generation (stages 8-11) first.' });
        return;
      }

      log.info('Running quality gauntlet', {
        sessionId: req.params.sessionId,
        proseLength: assembledProse.length,
        wordCount: assembledProse.split(/\s+/).filter(Boolean).length,
      });

      const gauntlet = createDefaultGauntlet();

      // Build corpus context from quote spans for claim verification
      const allSpanChunks = session.quote_spans.map(span => ({
        id: span.quote_id,
        content: span.repaired_text ?? span.text,
        relevanceScore: span.provenance_scorecard?.fidelity_score ?? 0.7,
        metadata: {
          author: span.source_anchor?.split(',')[0]?.trim() ?? span.doc_id,
          year: 0,
          title: span.doc_id,
          page_start: typeof span.page === 'number' ? span.page : span.page[0],
          page_end: typeof span.page === 'number' ? span.page : span.page[1],
          docId: span.doc_id,
        },
      }));

      const gauntletResult: GauntletResult = await gauntlet.runGauntlet(assembledProse, 1, {
        corpusChunks: allSpanChunks as any,
        corpusSources: [],
        knownAuthors: [...new Set(allSpanChunks.map(c => c.metadata.author).filter(Boolean))],
      });

      // Update session quality_gates with gauntlet results
      if (!session.quality_gates) {
        session.quality_gates = {} as any;
      }
      session.quality_gates!.gauntlet = {
        passed: gauntletResult.passed,
        overall_score: gauntletResult.overallScore,
        stages_passed: gauntletResult.summary?.stagesPassed ?? 0,
        total_stages: gauntletResult.summary?.totalStages ?? 0,
        critical_issues: gauntletResult.criticalIssues?.length ?? 0,
        revision_required: gauntletResult.revisionRequired ?? false,
        stage_results: gauntletResult.stageResults?.map((s: any) => ({
          name: s.stageName ?? s.name ?? 'unknown',
          score: s.score ?? 0,
          passed: s.passed ?? false,
        })) ?? [],
      };

      log.info('Quality gauntlet complete', {
        sessionId: req.params.sessionId,
        passed: gauntletResult.passed,
        score: gauntletResult.overallScore,
        stages: `${gauntletResult.summary?.stagesPassed}/${gauntletResult.summary?.totalStages}`,
      });

      res.json({
        sessionId: req.params.sessionId,
        gauntlet: session.quality_gates!.gauntlet,
        allIssues: gauntletResult.allIssues,
        revisionGuidance: gauntletResult.revisionGuidance,
        session: serializeSession(session),
      });
    } catch (error: any) {
      log.error('Failed to run quality gauntlet', error);
      res.status(500).json({ error: 'Failed to run quality gauntlet', details: error.message });
    }
  });

  /**
   * POST /api/icp/verify — Update verification status
   * Body: { sessionId: string, quoteId: string, status: VerificationStatus, correctedText?: string }
   */
  router.post('/verify', (req: Request, res: Response) => {
    try {
      if (!req.body || typeof req.body !== 'object') {
        res.status(400).json({ error: 'Request body required' });
        return;
      }
      const { sessionId, quoteId, status, correctedText } = req.body;

      if (!sessionId || !quoteId || !status) {
        res.status(400).json({ error: 'Missing required fields: sessionId, quoteId, status' });
        return;
      }

      const session = sessions.get(sessionId);
      if (!session) {
        res.status(404).json({ error: 'Session not found', sessionId });
        return;
      }

      // Find the span
      const span = session.quote_spans.find(
        s => s.quote_id === quoteId || s.span_fingerprint === quoteId,
      );
      if (!span) {
        res.status(404).json({ error: 'Quote span not found', quoteId });
        return;
      }

      // Update status
      const validStatuses: VerificationStatus[] = [
        'auto_verified', 'human_verified', 'human_corrected',
        'stale_verified', 'flagged', 'auto_rejected', 'rejected',
      ];
      if (!validStatuses.includes(status)) {
        res.status(400).json({ error: `Invalid status. Must be one of: ${validStatuses.join(', ')}` });
        return;
      }

      span.verification_status = status;
      if (correctedText && status === 'human_corrected') {
        span.text = correctedText;
      }

      emitVerificationEvent(session, span.quote_id, status, 'user');

      res.json({
        quoteId: span.quote_id,
        span_fingerprint: span.span_fingerprint,
        canonical_fingerprint: span.canonical_fingerprint,
        status: span.verification_status,
      });
    } catch (error: any) {
      res.status(500).json({ error: 'Failed to verify', details: error.message });
    }
  });

