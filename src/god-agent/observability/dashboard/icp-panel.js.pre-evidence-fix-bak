                <span class="quote-source-page">${Array.isArray(s.page) ? 'pp. ' + s.page[0] + '\u2013' + s.page[1] : 'p. ' + (s.page || '?')}${s.auto_confidence != null ? ' \u00b7 ' + (s.auto_confidence * 100).toFixed(0) + '%' : ''}</span>
