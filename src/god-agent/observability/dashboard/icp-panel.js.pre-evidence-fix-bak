/**
 * Generate claims from evidence (stage 5 only), then switch to Binding tab
 * for user review before atom decomposition and binding.
 */
async function icpGenerateClaims() {
  if (!icpState.currentSessionId || !icpState.session) {
    showICPError('No session loaded.');
    return;
  }

  var btn = document.getElementById('icp-continue-binding-btn');
  var statusEl = document.getElementById('icp-continue-status');
  if (btn) { btn.disabled = true; btn.textContent = 'Generating claims...'; }
  if (statusEl) { statusEl.innerHTML = '<span class="pipeline-running">Generating Toulmin claims from evidence... This may take 30-60 seconds.</span>'; }

  try {
    var data = await icpPost('/generate-claims/' + icpState.currentSessionId, {});
    icpState.session = data.session;
    showICPSuccess(data.claims + ' claims generated. Review and select claims to bind.');
    icpSwitchPanel('binding');
  } catch (err) {
    showICPError('Claim generation failed: ' + err.message);
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Generate Claims (Stage 5)'; }
    if (statusEl) { statusEl.innerHTML = ''; }
  }
}

/**
 * Bind selected claims (stages 6-7): atom decomposition, binding, writing contract, stress test.
 * Collects excluded claim IDs from unchecked checkboxes and sends to the backend.
 */
async function icpBindAndStress() {
  if (!icpState.currentSessionId || !icpState.session) {
    showICPError('No session loaded.');
    return;
  }

  var checkboxes = document.querySelectorAll('.icp-claim-checkbox');
  var excludeClaimIds = [];
  checkboxes.forEach(function(cb) {
    if (!cb.checked) {
      excludeClaimIds.push(cb.dataset.claimId);
    }
  });

  var totalClaims = (icpState.session.claim_map?.claims || []).length;
  var selectedCount = totalClaims - excludeClaimIds.length;
  if (selectedCount === 0) {
    showICPError('No claims selected. Select at least one claim to bind.');
    return;
  }

  var btn = document.getElementById('icp-bind-stress-btn');
  var statusEl = document.getElementById('icp-bind-stress-status');
  if (btn) { btn.disabled = true; btn.textContent = 'Binding ' + selectedCount + ' claims...'; }
  if (statusEl) { statusEl.innerHTML = '<span class="pipeline-running">Decomposing claims into atoms, binding to evidence, and running stress test... This may take 30-60 seconds.</span>'; }

  try {
    var data = await icpPost('/bind-and-stress/' + icpState.currentSessionId, { excludeClaimIds: excludeClaimIds });
    icpState.session = data.session;
    var atoms = data.session?.atoms?.length || 0;
    var bindings = data.session?.bindings?.length || 0;
    showICPSuccess(atoms + ' atoms, ' + bindings + ' bindings created from ' + selectedCount + ' claims.');
    renderBindingPanel(document.getElementById('icp-panel-content'), icpState.session);
  } catch (err) {
    showICPError('Bind & stress test failed: ' + err.message);
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Bind Selected Claims (Stages 6-7)'; }
    if (statusEl) { statusEl.innerHTML = ''; }
  }
}

/**
 * Toggle all claim checkboxes on or off.
 */
function icpToggleAllClaims(checked) {
  document.querySelectorAll('.icp-claim-checkbox').forEach(function(cb) {
    cb.checked = checked;
  });
  icpUpdateClaimCount();
}

/**
 * Update the "N/M selected" count display.
 */
function icpUpdateClaimCount() {
  var checkboxes = document.querySelectorAll('.icp-claim-checkbox');
  var total = checkboxes.length;
  var selected = 0;
  checkboxes.forEach(function(cb) { if (cb.checked) selected++; });
  var countEl = document.querySelector('.icp-claims-selected-count');
  if (countEl) { countEl.textContent = selected + '/' + total + ' selected'; }
}

