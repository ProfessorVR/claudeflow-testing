// PANEL 11: ANALYTICS (Pipeline Signal Breakdown)
// =============================================================================

function renderAnalyticsPanel(container, session) {
  var pm = session.pipeline_metrics;

  container.innerHTML = '<div class="icp-analytics"><h3>Pipeline Analytics</h3><div class="icp-analytics-grid" id="icp-analytics-grid"></div></div>';
  var grid = document.getElementById('icp-analytics-grid');
  if (!grid) return;

  // Section 1: Ranking Signal Breakdown
  grid.innerHTML += renderRankingSection(pm && pm.ranking);

  // Section 2: Cross-Encoder Impact
  grid.innerHTML += renderCrossEncoderSection(pm && pm.retrieval);

  // Section 3: Argumentative Role Distribution
  grid.innerHTML += renderRolesSection(pm && pm.retrieval);

  // Section 4: Diversity Selection (MMR)
  grid.innerHTML += renderMmrSection(pm && pm.retrieval);

  // Section 5: Binding Quality Assessment
  grid.innerHTML += renderBindingQualitySection(pm && pm.bindingQuality);

  // Section 6: Embedding Status
  grid.innerHTML += renderEmbeddingSection(pm && pm.embedding);
}

function renderRankingSection(ranking) {
  if (!ranking || !ranking.spanSignals || ranking.spanSignals.length === 0) {
    return '<div class="icp-analytics-section"><h4>Ranking Signal Breakdown</h4><div class="analytics-placeholder">Not available \u2014 run pipeline first</div></div>';
  }

  var signalNames = ['facetAlignment', 'roleWeight', 'bindingPotential', 'authority', 'redundancyResistance', 'lengthSuitability'];
  var shortNames = ['facetAlign', 'roleWt', 'bindPot', 'authority', 'redundancy', 'length'];

  var rows = '';
  for (var i = 0; i < ranking.spanSignals.length && i < 30; i++) {
    var s = ranking.spanSignals[i];
    var rrfClass = s.rrfScore > 0.015 ? 'rrf-score-green' : (s.rrfScore > 0.010 ? 'rrf-score-yellow' : 'rrf-score-red');
    var quoteTrunc = s.quote_id.slice(0, 8);
    var method = s.clusterMethod ? ' <span style="color:#888;font-size:0.7rem">(' + escapeHtml(s.clusterMethod) + ')</span>' : '';

    rows += '<tr>';
    rows += '<td>' + s.rank + '</td>';
    rows += '<td title="' + safeAttr(s.quote_id) + '">' + escapeHtml(quoteTrunc) + '...' + method + '</td>';

    for (var j = 0; j < signalNames.length; j++) {
      var val = s.signals[signalNames[j]] || 0;
      var pct = Math.round(val * 100);
      var barColor = val >= 0.7 ? '#4caf50' : (val >= 0.4 ? '#ff9800' : '#f44336');
      rows += '<td><div class="signal-bar-container"><div class="signal-bar" style="width:' + pct + '%;max-width:60px;background:' + barColor + '"></div><span class="signal-bar-label">' + val.toFixed(2) + '</span></div></td>';
    }

    rows += '<td class="' + rrfClass + '">' + s.rrfScore.toFixed(4) + '</td>';
    rows += '</tr>';
  }

  var headers = '<th>#</th><th>Quote</th>';
  for (var k = 0; k < shortNames.length; k++) {
    headers += '<th>' + escapeHtml(shortNames[k]) + '</th>';
  }
  headers += '<th>RRF</th>';

  var info = '<div class="analytics-stats" style="margin-bottom:12px">';
  info += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + ranking.spanSignals.length + '</div><div class="analytics-stat-lbl">Spans Ranked</div></div>';
  info += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + ranking.totalClusters + '</div><div class="analytics-stat-lbl">Clusters</div></div>';
  info += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + ranking.totalAliases + '</div><div class="analytics-stat-lbl">Aliases Collapsed</div></div>';
  info += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + ranking.k + '</div><div class="analytics-stat-lbl">RRF K</div></div>';
  info += '</div>';

  return '<div class="icp-analytics-section"><h4>Ranking Signal Breakdown</h4>' + info + '<div style="overflow-x:auto"><table class="signal-table"><thead><tr>' + headers + '</tr></thead><tbody>' + rows + '</tbody></table></div></div>';
}

function renderCrossEncoderSection(retrieval) {
  if (!retrieval) {
    return '<div class="icp-analytics-section"><h4>Cross-Encoder Impact</h4><div class="analytics-placeholder">Not available \u2014 run pipeline first</div></div>';
  }

  var ce = retrieval.crossEncoder;
  var availClass = ce.available ? 'analytics-stat-yes' : 'analytics-stat-no';
  var scoreChange = ce.avgScoreChange >= 0 ? '+' + ce.avgScoreChange.toFixed(3) : ce.avgScoreChange.toFixed(3);

  var html = '<div class="analytics-stats">';
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val ' + availClass + '">' + (ce.available ? 'Yes' : 'No') + '</div><div class="analytics-stat-lbl">Available</div></div>';
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + ce.spansReranked + '</div><div class="analytics-stat-lbl">Spans Re-ranked</div></div>';
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + scoreChange + '</div><div class="analytics-stat-lbl">Avg Score Change</div></div>';
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + (ce.blendRatio[0] * 100) + '% / ' + (ce.blendRatio[1] * 100) + '%</div><div class="analytics-stat-lbl">Blend (CE / Retrieval)</div></div>';
  html += '</div>';

  return '<div class="icp-analytics-section"><h4>Cross-Encoder Impact</h4>' + html + '</div>';
}

function renderRolesSection(retrieval) {
  if (!retrieval || !retrieval.roles || !retrieval.roles.distribution) {
    return '<div class="icp-analytics-section"><h4>Argumentative Role Distribution</h4><div class="analytics-placeholder">Not available \u2014 run pipeline first</div></div>';
  }

  var dist = retrieval.roles.distribution;
  var roleColors = {
    DEFINITION: '#2196f3',
    CLAIM: '#4caf50',
    EVIDENCE: '#ff9800',
    INTERPRETATION: '#9c27b0',
    TRANSITION: '#00bcd4',
    META: '#607d8b'
  };

  var total = 0;
  var roles = [];
  for (var role in dist) {
    total += dist[role];
    roles.push({ name: role, count: dist[role] });
  }
  roles.sort(function(a, b) { return b.count - a.count; });

  var html = '<div class="role-bar-container">';
  for (var i = 0; i < roles.length; i++) {
    var r = roles[i];
    var pct = total > 0 ? Math.round(r.count / total * 100) : 0;
    var color = roleColors[r.name] || '#607d8b';
    html += '<div class="role-bar-row">';
    html += '<span class="role-bar-label">' + escapeHtml(r.name) + '</span>';
    html += '<div class="role-bar-track"><div class="role-bar-fill" style="width:' + pct + '%;background:' + color + '">' + (pct >= 10 ? pct + '%' : '') + '</div></div>';
    html += '<span class="role-bar-count">' + r.count + '</span>';
    html += '</div>';
  }
  html += '</div>';

  return '<div class="icp-analytics-section"><h4>Argumentative Role Distribution</h4>' + html + '</div>';
}

function renderMmrSection(retrieval) {
  if (!retrieval || !retrieval.mmr) {
    return '<div class="icp-analytics-section"><h4>Diversity Selection (MMR)</h4><div class="analytics-placeholder">Not available \u2014 run pipeline first</div></div>';
  }

  var mmr = retrieval.mmr;
  var ratio = mmr.totalCandidates > 0 ? Math.round(mmr.totalSelected / mmr.totalCandidates * 100) : 0;

  var html = '<div class="analytics-stats">';
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + mmr.totalSelected + '</div><div class="analytics-stat-lbl">Selected</div></div>';
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + mmr.totalCandidates + '</div><div class="analytics-stat-lbl">Candidates</div></div>';
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + ratio + '%</div><div class="analytics-stat-lbl">Selection Ratio</div></div>';
  html += '</div>';

  // Semantic windows info
  var sw = retrieval.semanticWindows;
  if (sw) {
    html += '<div class="analytics-stats" style="margin-top:12px">';
    html += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + sw.totalExpansions + '</div><div class="analytics-stat-lbl">Window Expansions</div></div>';
    html += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + (sw.avgWindowSentences > 0 ? sw.avgWindowSentences.toFixed(1) : '0') + '</div><div class="analytics-stat-lbl">Avg Window Size</div></div>';
    html += '</div>';
  }

  // Lambda schedule table
  var schedule = mmr.lambdaSchedule;
  if (schedule && Object.keys(schedule).length > 0) {
    html += '<table class="lambda-table"><thead><tr><th>Facet</th><th>Lambda Picks</th></tr></thead><tbody>';
    for (var facetId in schedule) {
      html += '<tr><td>' + escapeHtml(facetId.slice(0, 12)) + '</td><td>' + schedule[facetId].map(function(l) { return l.toFixed(2); }).join(', ') + '</td></tr>';
    }
    html += '</tbody></table>';
  }

  return '<div class="icp-analytics-section"><h4>Diversity Selection (MMR)</h4>' + html + '</div>';
}

function renderBindingQualitySection(bq) {
  if (!bq || !bq.assessments || bq.assessments.length === 0) {
    return '<div class="icp-analytics-section"><h4>Binding Quality (Claude-as-Judge)</h4><div class="analytics-placeholder">Not available \u2014 run pipeline with claims to enable binding quality assessment</div></div>';
  }

  // Summary stats
  var html = '<div class="analytics-stats" style="margin-bottom:12px">';
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + bq.totalAssessed + '</div><div class="analytics-stat-lbl">Assessed</div></div>';
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + bq.totalDemoted + '</div><div class="analytics-stat-lbl">Demoted</div></div>';
  var avgClass = bq.avgOverall >= 0.7 ? 'analytics-stat-yes' : (bq.avgOverall >= 0.45 ? '' : 'analytics-stat-no');
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val ' + avgClass + '">' + bq.avgOverall.toFixed(2) + '</div><div class="analytics-stat-lbl">Avg Overall</div></div>';
  html += '</div>';

  // Per-binding cards (limit to 20)
  html += '<div class="judge-cards">';
  var dimensions = ['relevance', 'quotability', 'argumentative_weight', 'source_authority', 'contextual_fit'];
  var dimLabels = ['Relevance', 'Quotability', 'Arg. Weight', 'Source Auth.', 'Context Fit'];

  for (var i = 0; i < bq.assessments.length && i < 20; i++) {
    var a = bq.assessments[i];
    var overall = a.scores.overall;
    var scoreClass = overall >= 0.7 ? 'judge-score-green' : (overall >= 0.45 ? 'judge-score-yellow' : 'judge-score-red');

    html += '<div class="judge-card">';
    html += '<div class="judge-card-ids">' + escapeHtml(a.atomId.slice(0, 8)) + '<br/>' + escapeHtml(a.quoteId.slice(0, 8)) + '</div>';
    html += '<div class="judge-dimensions">';
    for (var d = 0; d < dimensions.length; d++) {
      var val = a.scores[dimensions[d]] || 0;
      var dimColor = val >= 0.7 ? '#4caf50' : (val >= 0.4 ? '#ff9800' : '#f44336');
      html += '<div class="judge-dimension">';
      html += '<span class="judge-dim-label">' + dimLabels[d] + '</span>';
      html += '<div class="judge-dim-bar"><div class="judge-dim-fill" style="width:' + Math.round(val * 100) + '%;background:' + dimColor + '"></div></div>';
      html += '<span class="judge-dim-score">' + val.toFixed(2) + '</span>';
      html += '</div>';
    }
    html += '</div>';
    html += '<div class="judge-overall"><div class="judge-overall-score ' + scoreClass + '">' + (overall * 100).toFixed(0) + '</div>';
    if (a.demoted) html += '<span class="judge-badge-demoted">DEMOTED</span>';
    html += '</div>';
    html += '</div>';
  }
  html += '</div>';

  return '<div class="icp-analytics-section"><h4>Binding Quality (Claude-as-Judge)</h4>' + html + '</div>';
}

function renderEmbeddingSection(embedding) {
  if (!embedding) {
    return '<div class="icp-analytics-section"><h4>Embedding Status</h4><div class="analytics-placeholder">Not available \u2014 run pipeline first</div></div>';
  }

  var availClass = embedding.providerAvailable ? 'analytics-stat-yes' : 'analytics-stat-no';
  var html = '<div class="analytics-stats">';
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val ' + availClass + '">' + (embedding.providerAvailable ? 'Yes' : 'No') + '</div><div class="analytics-stat-lbl">Provider Available</div></div>';
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + embedding.spanCacheSize + '</div><div class="analytics-stat-lbl">Span Cache</div></div>';
  html += '<div class="analytics-stat-card"><div class="analytics-stat-val">' + embedding.facetCacheSize + '</div><div class="analytics-stat-lbl">Facet Cache</div></div>';
  html += '</div>';

  return '<div class="icp-analytics-section"><h4>Embedding Status</h4>' + html + '</div>';
}

// =============================================================================
// UTILITIES
// =============================================================================

function escapeHtml(text) {
  if (!text) return '';
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

function safeAttr(str) {
  if (!str) return '';
  return String(str).replace(/&/g, '&amp;').replace(/'/g, '&#39;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function showICPSuccess(msg) {
  console.log('[ICP]', msg);
  const toast = document.createElement('div');
  toast.className = 'icp-toast success';
  toast.textContent = msg;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 3000);
}

function showICPError(msg) {
  console.error('[ICP]', msg);
  // Show a brief toast notification
  const toast = document.createElement('div');
  toast.className = 'icp-toast error';
  toast.textContent = msg;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 4000);
}
