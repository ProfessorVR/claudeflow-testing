/**
 * Run the gauntlet revision loop: auto-fix + re-generate + re-evaluate.
 * Iterates up to maxAttempts times, stopping on pass or stall.
 */
async function icpReviseGauntlet() {
  if (!icpState.currentSessionId || !icpState.session) {
    showICPError('No session loaded.');
    return;
  }

  var btn = document.getElementById('icp-revise-gauntlet-btn');
  var statusEl = document.getElementById('icp-revise-status');
  if (btn) { btn.disabled = true; btn.textContent = 'Revising...'; }
  if (statusEl) {
    statusEl.innerHTML = '<span class="pipeline-running">Running revision loop: auto-fix \u2192 re-generate \u2192 re-evaluate. This may take 2-5 minutes per iteration...</span>';
  }

  try {
    var data = await icpPost('/revise-gauntlet/' + icpState.currentSessionId, { maxAttempts: 3 });
    icpState.session = data.session;

    var msg = data.passed
      ? 'Gauntlet PASSED after ' + data.iterations + ' revision(s)! Score: ' + (data.gauntlet.overall_score * 100).toFixed(0) + '%'
      : 'Revision complete (' + data.iterations + ' iteration(s)). Score: ' + (data.gauntlet.overall_score * 100).toFixed(0) + '% — still failing.';
    if (data.passed) {
      showICPSuccess(msg);
    } else {
      showICPError(msg);
    }
    renderQualityPanel(document.getElementById('icp-panel-content'), icpState.session);
  } catch (err) {
    showICPError('Revision failed: ' + err.message);
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Revise (auto-fix + re-generate)'; }
    if (statusEl) { statusEl.innerHTML = ''; }
  }
}

