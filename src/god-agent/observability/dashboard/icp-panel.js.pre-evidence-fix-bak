async function icpRefreshSession() {
  if (icpState.currentSessionId) {
    await icpSelectSession(icpState.currentSessionId);
  }
}

async function icpLoadStyleProfiles() {
  try {
    const data = await fetch('/api/god-write/profiles').then(r => r.json());
    const select = document.getElementById('icp-style-profile');
    if (!select || !data.profiles) return;
    for (const p of data.profiles) {
      const opt = document.createElement('option');
      opt.value = p.id;
      opt.textContent = `${p.name}${p.active ? ' (active)' : ''}`;
      if (p.active) opt.selected = true;
      select.appendChild(opt);
    }
  } catch { /* profiles endpoint unavailable */ }
}

async function icpLoadCorpusFolders() {
  try {
    const data = await icpFetch('/corpus-folders');
    const select = document.getElementById('icp-corpus-folder');
    if (!select || !data.folders) return;
    for (const folder of data.folders) {
      const opt = document.createElement('option');
      opt.value = folder;
      opt.textContent = folder;
      select.appendChild(opt);
    }
    // Auto-load sources for the first folder (if only one) or previously selected
    if (data.folders.length === 1) {
      select.value = data.folders[0];
      icpLoadCorpusSources(data.folders[0]);
    }
  } catch { /* corpus folders endpoint unavailable */ }
}

async function icpLoadCorpusSources(folder) {
  const primaryEl = document.getElementById('icp-primary-sources');
  const secondaryEl = document.getElementById('icp-secondary-sources');
  if (!primaryEl || !secondaryEl) return;

  const placeholder = '<span class="icp-sp-placeholder">Select corpus folder first...</span>';
  if (!folder) {
    primaryEl.innerHTML = placeholder;
    secondaryEl.innerHTML = placeholder;
    return;
  }

  primaryEl.innerHTML = '<span class="icp-sp-placeholder">Loading...</span>';
  secondaryEl.innerHTML = '<span class="icp-sp-placeholder">Loading...</span>';

  try {
    const data = await icpFetch(`/corpus-sources/${encodeURIComponent(folder)}`);
    const sources = data.sources || [];

    const buildChecklist = (container, prefix) => {
      container.innerHTML = '';
      if (sources.length === 0) {
        container.innerHTML = '<span class="icp-sp-placeholder">No sources found</span>';
        return;
      }
      for (const src of sources) {
        for (const work of (src.works && src.works.length > 0 ? src.works : ['(untitled)'])) {
          const id = `${prefix}-${(src.author + '-' + work).replace(/[^a-zA-Z0-9]/g, '_')}`;
          const label = document.createElement('label');
          label.className = 'icp-sp-check-item';
          label.htmlFor = id;
          const cb = document.createElement('input');
          cb.type = 'checkbox';
          cb.id = id;
          cb.name = prefix;
          cb.value = src.author;
          cb.dataset.work = work;
          const text = document.createElement('span');
          text.className = 'icp-sp-check-text';
          text.innerHTML = `<strong>${escapeHtml(src.author)}</strong> &mdash; <em>${escapeHtml(work)}</em>`;
          label.appendChild(cb);
          label.appendChild(text);
          container.appendChild(label);
        }
      }
    };

    buildChecklist(primaryEl, 'primary');
    buildChecklist(secondaryEl, 'secondary');
  } catch {
    primaryEl.innerHTML = '<span class="icp-sp-placeholder">Failed to load sources</span>';
    secondaryEl.innerHTML = '<span class="icp-sp-placeholder">Failed to load sources</span>';
  }
}

function icpGetCheckedSources(containerId) {
  const container = document.getElementById(containerId);
  if (!container) return [];
  const checked = container.querySelectorAll('input[type="checkbox"]:checked');
  return [...checked].map(function(cb) {
    return { author: cb.value, title: cb.dataset.work || '' };
  });
}

function icpOnCorpusFolderChange(folder) {
  icpLoadCorpusSources(folder);
}

