function renderSuperPromptPanel(container, session) {
  const superPrompts = session.super_prompts || [];

  // Compute aggregate enrichment stats
  let totalApplied = 0;
  let totalTokenEstimate = 0;
  for (const sp of superPrompts) {
    if (sp.enrichment_manifest) {
      totalApplied += sp.enrichment_manifest.applied_count;
      totalTokenEstimate += sp.enrichment_manifest.total_token_estimate;
    }
  }
  const enrichmentSummary = superPrompts.length > 0 && totalApplied > 0
    ? `<div class="enrichment-stats">${totalApplied} enrichments applied across ${superPrompts.length} paragraphs (~${totalTokenEstimate} enrichment tokens)</div>`
    : '';

  // Compute cache stats (only after execution)
  const executedWithCache = superPrompts.filter(sp => sp.executed && sp.static_system_block);
  const cacheHits = executedWithCache.filter(sp => sp.cache_hit).length;
  const cacheSummary = executedWithCache.length > 0
    ? `<div class="cache-stats">${cacheHits}/${executedWithCache.length} paragraphs cache-hit${cacheHits > 0 ? ' (static prefix reused)' : ''}</div>`
    : '';

  container.innerHTML = `
    <div class="icp-superprompt">
      <h3>SuperPrompts (${superPrompts.length} paragraphs)</h3>
      ${enrichmentSummary}
      ${cacheSummary}

      <div class="planner-actions">
        <button class="btn btn-primary" onclick="icpGenerateAll()">Generate All</button>
        <button class="btn btn-secondary" onclick="icpReassembleSuperPrompts()">Re-assemble</button>
      </div>

      ${superPrompts.length === 0
        ? '<p class="muted">No super-prompts assembled yet. Go to Planner tab and click "Assemble SuperPrompts".</p>'
        : superPrompts.map(sp => renderSuperPromptCard(sp)).join('')
      }
    </div>
  `;
}

function renderSuperPromptCard(sp) {
  const statusClass = sp.executed ? 'executed' : 'assembled';
  const statusLabel = sp.executed ? 'executed' : 'assembled (not executed)';
  const manifest = sp.enrichment_manifest;
  const enriched = manifest && manifest.enriched;
  const cardClass = enriched ? 'superprompt-card enriched' : 'superprompt-card';

  // Enrichment badge
  const enrichmentBadge = manifest
    ? (enriched
      ? `<span class="enrichment-badge">${manifest.applied_count} enrichments</span>`
      : '<span class="enrichment-badge basic">basic</span>')
    : '';

  // Cache hit/miss badge (only shown after execution)
  const cacheBadge = sp.executed && sp.static_system_block
    ? (sp.cache_hit
      ? '<span class="cache-badge cache-hit">Cache HIT</span>'
      : '<span class="cache-badge cache-miss">Cache MISS</span>')
    : '';

  // Enrichment chips row
  const enrichmentChips = manifest && manifest.entries && manifest.entries.length > 0
    ? `<div class="enrichment-badges">${manifest.entries.map(e =>
        `<span class="enrichment-chip ${e.applied ? 'applied' : 'skipped'}" title="${escapeHtml(e.applied ? e.summary : (e.skip_reason || 'skipped'))}">${escapeHtml(e.label)}</span>`
      ).join('')}</div>`
    : '';

  // Enrichment details section
  const enrichmentDetails = manifest && manifest.entries && manifest.entries.length > 0
    ? `<div class="superprompt-section-toggle" onclick="icpToggleSuperPromptSection('${safeAttr(sp.paragraph_id)}', 'enrichment')">
        &#9660; Enrichment Details (~${manifest.total_token_estimate} tokens)
      </div>
      <div class="superprompt-section-content" id="sp-enrichment-${safeAttr(sp.paragraph_id)}">
        ${manifest.entries.map(e => `
          <div class="enrichment-detail ${e.applied ? '' : 'skipped'}">
            <div class="enrichment-detail-header">
              <span class="enrichment-chip ${e.applied ? 'applied' : 'skipped'}">${escapeHtml(e.label)}</span>
              <span class="enrichment-tokens">${e.token_estimate} tokens</span>
              ${e.skip_reason ? `<span class="enrichment-skip-reason">${escapeHtml(e.skip_reason)}</span>` : ''}
            </div>
            <div class="enrichment-detail-summary">${escapeHtml(e.summary)}</div>
          </div>
        `).join('')}
      </div>`
    : '';

  return `
    <div class="${cardClass}">
      <div class="superprompt-status">
        <span class="dot ${statusClass}"></span> ${statusLabel} ${enrichmentBadge} ${cacheBadge}
      </div>
      <div class="superprompt-meta">
        <strong>P${sp.paragraph_order + 1}</strong> &mdash;
        Atoms: ${(sp.atom_ids || []).length} &middot;
        Quotes: ${(sp.quote_ids || []).length} &middot;
        Citations: ${(sp.citation_keys || []).length}
      </div>

      ${enrichmentChips}
      ${enrichmentDetails}

      <div class="superprompt-section-toggle" onclick="icpToggleSuperPromptSection('${safeAttr(sp.paragraph_id)}', 'system')">
        &#9660; System Prompt
      </div>
      <div class="superprompt-section-content" id="sp-system-${safeAttr(sp.paragraph_id)}">${escapeHtml(sp.system_prompt || '')}</div>

      <div class="superprompt-section-toggle" onclick="icpToggleSuperPromptSection('${safeAttr(sp.paragraph_id)}', 'user')">
        &#9660; User Prompt
      </div>
      <div class="superprompt-section-content" id="sp-user-${safeAttr(sp.paragraph_id)}">${escapeHtml(sp.user_prompt || '')}</div>

      ${sp.executed && sp.generated_text ? `
        <div class="superprompt-section-toggle" onclick="icpToggleSuperPromptSection('${safeAttr(sp.paragraph_id)}', 'text')">
          &#9660; Generated Text
        </div>
        <div class="superprompt-section-content" id="sp-text-${safeAttr(sp.paragraph_id)}">${escapeHtml(sp.generated_text)}</div>
      ` : ''}

      <div class="superprompt-actions">
        <button class="btn btn-secondary btn-sm" onclick="icpRegenerateParagraph('${safeAttr(sp.paragraph_id)}')">Regenerate This Paragraph</button>
      </div>
    </div>
  `;
}

function icpToggleSuperPromptSection(paragraphId, section) {
  const el = document.getElementById('sp-' + section + '-' + paragraphId);
  if (el) {
    el.classList.toggle('expanded');
  }
}

async function icpGenerateAll() {
  if (!icpState.currentSessionId) return;

  var btn = document.querySelector('.icp-superprompt .btn-primary');
  var container = document.getElementById('icp-panel-content');
  var statusDiv = document.createElement('div');
  statusDiv.className = 'pipeline-running';
  statusDiv.style.margin = '12px 0';
  statusDiv.innerHTML = 'Generating paragraphs from superprompts... This may take 1-2 minutes.';
  if (btn) {
    btn.disabled = true;
    btn.textContent = 'Generating...';
    btn.parentNode.insertBefore(statusDiv, btn.nextSibling);
  }

  try {
    var result = await icpPost('/generate-from-superprompt/' + icpState.currentSessionId, {});
    icpState.session = result.session;
    icpState.exportPackage = result.exportPackage || null;
    var wordCount = result.exportPackage?.word_count || 0;
    showICPSuccess('All paragraphs generated (' + wordCount + ' words)');
    renderSuperPromptPanel(container, icpState.session);
  } catch (err) {
    showICPError('Generate failed: ' + err.message);
    if (statusDiv.parentNode) statusDiv.remove();
    if (btn) { btn.disabled = false; btn.textContent = 'Generate All'; }
  }
}

async function icpReassembleSuperPrompts() {
  if (!icpState.currentSessionId) return;

  var btn = document.querySelectorAll('.icp-superprompt .btn-secondary')[0];
  if (btn) { btn.disabled = true; btn.textContent = 'Assembling...'; }

  try {
    var result = await icpPost('/superprompt/' + icpState.currentSessionId, {});
    icpState.session = result.session;
    showICPSuccess('SuperPrompts re-assembled');
    renderSuperPromptPanel(document.getElementById('icp-panel-content'), icpState.session);
  } catch (err) {
    showICPError('Re-assemble failed: ' + err.message);
    if (btn) { btn.disabled = false; btn.textContent = 'Re-assemble'; }
  }
}

async function icpRegenerateParagraph(paragraphId) {
  if (!icpState.currentSessionId) return;
  try {
    const result = await icpPost('/regenerate-paragraph/' + icpState.currentSessionId + '/' + paragraphId, {});
    icpState.session = result.session;
    showICPSuccess('Paragraph regenerated');
    renderSuperPromptPanel(document.getElementById('icp-panel-content'), icpState.session);
