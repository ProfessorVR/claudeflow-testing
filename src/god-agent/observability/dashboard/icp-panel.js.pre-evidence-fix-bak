/**
 * Retrieve evidence for the current session using approved facets (stages 2-4).
 * Called from the Facets panel after user has verified/edited facets.
 */
async function icpRetrieveEvidence() {
  if (!icpState.currentSessionId || !icpState.session) {
    showICPError('No session. Decompose a prompt first.');
    return;
  }

  var activeFacets = (icpState.session.facets || []).filter(function(f) { return !f.archived; });
  if (activeFacets.length === 0) {
    showICPError('No active facets. Approve at least one facet before retrieving evidence.');
    return;
  }

  var btn = document.getElementById('icp-retrieve-evidence-btn');
  var statusEl = document.getElementById('icp-facet-status');
  if (btn) { btn.disabled = true; btn.textContent = 'Retrieving...'; }
  if (statusEl) { statusEl.innerHTML = '<span class="pipeline-running">Retrieving and verifying evidence for approved facets...</span>'; }

  try {
    await icpPost('/retrieve/' + icpState.currentSessionId, {});
    // Fetch the full updated session (retrieve endpoint only returns spans)
    var freshData = await icpFetch('/session/' + icpState.currentSessionId);
    icpState.session = freshData.session;
    icpSwitchPanel('evidence');
  } catch (err) {
    showICPError('Retrieval failed: ' + err.message);
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Retrieve Evidence'; }
    if (statusEl) { statusEl.innerHTML = ''; }
  }
}

/**
 * Add a custom facet to the current session.
 */
async function icpAddCustomFacet() {
  if (!icpState.currentSessionId) return;

  var nameEl = document.getElementById('icp-new-facet-name');
  var descEl = document.getElementById('icp-new-facet-desc');
  var roleEl = document.getElementById('icp-new-facet-role');
  var name = nameEl?.value?.trim();
  var description = descEl?.value?.trim();
  var facet_role = roleEl?.value || 'supporting';

  if (!name || !description) {
    showICPError('Facet name and description are required.');
    return;
  }

  try {
    await icpPost('/facets/' + icpState.currentSessionId, { name, description, facet_role });
    if (nameEl) nameEl.value = '';
    if (descEl) descEl.value = '';
    await icpRefreshSession();
  } catch (err) {
    showICPError('Failed to add facet: ' + err.message);
  }
}

