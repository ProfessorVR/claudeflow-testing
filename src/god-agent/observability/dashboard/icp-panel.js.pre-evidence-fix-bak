function renderFacetPanel(container, session) {
  var facets = session.facets || [];
  var active = facets.filter(function(f) { return !f.archived; });
  var archived = facets.filter(function(f) { return f.archived; });
  var verified = active.filter(function(f) { return f.human_verified; });
  var pending = active.filter(function(f) { return !f.human_verified; });
  var hasEvidence = (session.quote_spans || []).length > 0;

  function facetStatusClass(f) {
    if (f.archived) return 'facet-rejected';
    if (f.human_verified) return 'facet-verified';
    return 'facet-pending';
  }

  function facetStatusLabel(f) {
    if (f.archived) return 'Rejected';
    if (f.human_verified) return 'Approved';
    return 'Pending';
  }

  function roleColor(role) {
    if (role === 'core') return '#4caf50';
    if (role === 'supporting') return '#2196f3';
    return '#ff9800';
  }

  container.innerHTML = `
    <div class="icp-facet-review">
      <div class="icp-facet-review-header">
        <h3>Facet Review</h3>
        <div class="icp-facet-counts">
          <span class="facet-count-badge facet-count-verified">${verified.length} approved</span>
          <span class="facet-count-badge facet-count-pending">${pending.length} pending</span>
          ${archived.length ? '<span class="facet-count-badge facet-count-rejected">' + archived.length + ' rejected</span>' : ''}
        </div>
      </div>

      <p class="icp-facet-instructions">Review the facets generated from your prompt. <strong>Approve</strong> facets you want evidence for, <strong>reject</strong> those that are irrelevant, or <strong>edit</strong> names and descriptions. You can also add your own facets below.</p>

      <div class="icp-facet-cards">
        ${active.map(function(f) { return '<div class="icp-facet-review-card ' + facetStatusClass(f) + '" data-facet-id="' + safeAttr(f.facet_id) + '">' +
          '<div class="facet-review-top">' +
            '<span class="facet-review-role" style="background:' + roleColor(f.facet_role) + '">' + escapeHtml(f.facet_role) + '</span>' +
            '<span class="facet-review-status">' + facetStatusLabel(f) + '</span>' +
          '</div>' +
          '<div class="facet-review-name">' +
            '<input type="text" value="' + escapeHtml(f.name) + '" class="facet-review-name-input" onchange="icpUpdateFacet(\'' + safeAttr(f.facet_id) + '\', \'name\', this.value)" />' +
          '</div>' +
          '<textarea class="facet-review-desc" onchange="icpUpdateFacet(\'' + safeAttr(f.facet_id) + '\', \'description\', this.value)">' + escapeHtml(f.description) + '</textarea>' +
          '<div class="facet-review-meta">' +
            '<select class="facet-review-role-select" onchange="icpUpdateFacet(\'' + safeAttr(f.facet_id) + '\', \'facet_role\', this.value)">' +
              '<option value="core"' + (f.facet_role === 'core' ? ' selected' : '') + '>Core</option>' +
              '<option value="supporting"' + (f.facet_role === 'supporting' ? ' selected' : '') + '>Supporting</option>' +
              '<option value="exploratory"' + (f.facet_role === 'exploratory' ? ' selected' : '') + '>Exploratory</option>' +
            '</select>' +
          '</div>' +
          '<div class="facet-review-actions">' +
            (f.human_verified
              ? '<button class="btn btn-sm btn-outline" onclick="icpVerifyFacet(\'' + safeAttr(f.facet_id) + '\', false)">Unapprove</button>'
              : '<button class="btn btn-sm btn-success" onclick="icpVerifyFacet(\'' + safeAttr(f.facet_id) + '\', true)">Approve</button>') +
            '<button class="btn btn-sm btn-danger" onclick="icpArchiveFacet(\'' + safeAttr(f.facet_id) + '\', true)">Reject</button>' +
          '</div>' +
        '</div>'; }).join('')}
        ${active.length === 0 ? '<p class="muted">No active facets. Add a custom facet or decompose the prompt first.</p>' : ''}
      </div>

      ${archived.length > 0 ? '<details class="icp-facet-rejected-section"><summary>Rejected facets (' + archived.length + ')</summary><div class="icp-facet-cards">' +
        archived.map(function(f) { return '<div class="icp-facet-review-card facet-rejected" data-facet-id="' + safeAttr(f.facet_id) + '">' +
          '<div class="facet-review-top"><span class="facet-review-role" style="background:#666">' + escapeHtml(f.facet_role) + '</span><span class="facet-review-status">Rejected</span></div>' +
          '<div class="facet-review-name"><strong>' + escapeHtml(f.name) + '</strong></div>' +
          '<p class="facet-review-desc-text">' + escapeHtml(f.description) + '</p>' +
          '<div class="facet-review-actions"><button class="btn btn-sm btn-outline" onclick="icpArchiveFacet(\'' + safeAttr(f.facet_id) + '\', false)">Restore</button></div>' +
        '</div>'; }).join('') +
      '</div></details>' : ''}

      <div class="icp-facet-add-section">
        <h4>Add Custom Facet</h4>
        <div class="icp-facet-add-form">
          <input type="text" id="icp-new-facet-name" placeholder="Facet name (e.g., Aristotle on phantasia)" class="facet-add-name" />
          <textarea id="icp-new-facet-desc" placeholder="Description of what this facet should cover..." class="facet-add-desc"></textarea>
          <div class="facet-add-row">
            <select id="icp-new-facet-role" class="facet-add-role">
              <option value="core">Core</option>
              <option value="supporting" selected>Supporting</option>
              <option value="exploratory">Exploratory</option>
            </select>
            <button class="btn btn-secondary btn-sm" onclick="icpAddCustomFacet()">Add Facet</button>
          </div>
        </div>
      </div>

      <div class="icp-facet-retrieve-section">
        <button id="icp-retrieve-evidence-btn" class="btn btn-primary btn-run" onclick="icpRetrieveEvidence()"${active.length === 0 ? ' disabled' : ''}>Retrieve Evidence</button>
        <span class="icp-facet-retrieve-hint">${active.length} active facet${active.length !== 1 ? 's' : ''} will be used for retrieval (stages 2-4)</span>
        ${hasEvidence ? '<span class="icp-facet-retrieve-warn">This session already has evidence. Re-retrieving will replace existing spans.</span>' : ''}
        <div id="icp-facet-status"></div>
      </div>
    </div>
  `;
}

async function icpUpdateFacet(facetId, field, value) {
  try {
    await icpFetch(`/facets/${icpState.currentSessionId}/${facetId}`, {
      method: 'PUT',
      body: JSON.stringify({ [field]: value }),
    });
    await icpRefreshSession();
  } catch (err) {
    showICPError('Update failed: ' + err.message);
  }
}

