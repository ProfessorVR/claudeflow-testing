    if (span.auto_confidence != null) {
      html += '          <span class="quote-detail-confidence">Confidence: ' + (span.auto_confidence * 100).toFixed(0) + '%</span>';
    }
    html += '        </div>';
    html += '        <div class="icp-modal-section">';
    html += '          <label>Source</label>';
    html += '          <div id="icp-quote-doc-source" class="quote-detail-source">' + escapeHtml(docLabel) + '</div>';
    html += '          <div class="quote-detail-page">Page ' + page + (span.source_anchor ? ' (' + escapeHtml(span.source_anchor) + ')' : '') + '</div>';
    html += '        </div>';
    html += '        <div class="icp-modal-section">';
    html += '          <label>Full Quote <span id="icp-richtext-badge" class="icp-richtext-badge" style="display:none">formatted</span></label>';
    // P0.3: Show context-windowed text with bold core and grey context
    var fullQuoteHtml = '';
    if (span.core_text) {
      if (span.context_before) fullQuoteHtml += '<span class="quote-ctx">' + escapeHtml(span.context_before) + '</span> ';
      fullQuoteHtml += '<strong>' + escapeHtml(span.core_text) + '</strong>';
      if (span.context_after) fullQuoteHtml += ' <span class="quote-ctx">' + escapeHtml(span.context_after) + '</span>';
    } else {
      fullQuoteHtml = escapeHtml(spanText);
    }
    html += '          <div class="quote-detail-fulltext" id="icp-quote-fulltext">' + fullQuoteHtml + '</div>';
    html += '        </div>';
    html += '        <div class="icp-modal-section" id="icp-footnotes-section" style="display:none">';
    html += '          <label>Footnotes / Endnotes</label>';
    html += '          <div class="icp-footnotes-content" id="icp-footnotes-content"></div>';
    html += '        </div>';
    html += '        <div class="icp-modal-section icp-quote-trim">';
    html += '          <label>Select Quote Range <span class="icp-hint">(highlight text to keep, then click &ldquo;Use Selection&rdquo;)</span></label>';
    html += '          <div id="icp-quote-selectable" class="icp-quote-selectable" data-quote-id="' + spanQuoteId + '">' + escapeHtml(spanText) + '</div>';
    html += '          <div class="icp-trim-actions">';
    html += '            <button onclick="icpUseSelection()" class="btn btn-sm btn-primary">Use Selection</button>';
    html += '            <button onclick="icpResetTrim()" class="btn btn-sm btn-secondary">Reset</button>';
    html += '          </div>';
    html += '        </div>';
    html += '        <div class="icp-modal-section icp-ocr-correction">';
    html += '          <label>OCR Correction</label>';
    html += '          <div class="icp-edit-toolbar" id="icp-edit-toolbar">';
    html += '            <button onclick="icpEditFormat(\'italic\')" class="btn btn-sm icp-edit-btn" title="Italic (Ctrl+I)"><i>I</i></button>';
