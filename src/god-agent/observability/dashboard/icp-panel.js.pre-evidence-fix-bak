// =============================================================================
// SESSION MANAGEMENT
// =============================================================================

async function loadICPSessions() {
  try {
    const data = await icpFetch('/sessions');
    icpState.sessions = data.sessions || [];

    const select = document.getElementById('icp-session-select');
    if (!select) return;

    select.innerHTML = '<option value="">Select session...</option>';
    icpState.sessions.forEach(s => {
      const opt = document.createElement('option');
      opt.value = s.sessionId;
      opt.textContent = `${s.sessionId.slice(0, 8)}... (${s.quoteCount} quotes, ${s.atomCount} atoms)`;
      if (s.sessionId === icpState.currentSessionId) opt.selected = true;
      select.appendChild(opt);
    });
  } catch (err) {
    console.warn('Failed to load ICP sessions:', err.message);
  }
}

async function icpSelectSession(sessionId) {
  if (!sessionId) return;
  icpState.currentSessionId = sessionId;

  try {
    const data = await icpFetch(`/session/${sessionId}`);
    icpState.session = data.session;
    icpSwitchPanel(icpState.activePanel);
  } catch (err) {
    showICPError('Failed to load session: ' + err.message);
  }
}

async function icpCreateSession() {
  if (icpState.creating) return;

  const promptEl = document.getElementById('icp-prompt-input');
  const prompt = promptEl?.value?.trim();
  if (!prompt) {
    showICPError('Enter a research prompt before running.');
    return;
  }

  // Read optional source scope settings from the form
  const modeEl = document.getElementById('icp-source-mode');
  const mode = modeEl?.value || 'corpus';
  const minRelEl = document.getElementById('icp-min-relevance');
  const minRelevance = minRelEl ? parseFloat(minRelEl.value) || 0.35 : 0.35;
  const maxChunksEl = document.getElementById('icp-max-chunks');
  const maxChunks = maxChunksEl ? parseInt(maxChunksEl.value) || 40 : 40;

  const sourceScope = {
    mode,
    corpus_config: { collections: [], min_relevance: minRelevance, max_chunks: maxChunks },
    doc_authority_policy: { version: '1.0.0', tiers: { primary: 1, secondary: 2, tertiary: 3 } },
  };

  const styleEl = document.getElementById('icp-style-profile');
  const styleProfileId = styleEl?.value || undefined;

  const corpusFolderEl = document.getElementById('icp-corpus-folder');
  const corpusFolder = corpusFolderEl?.value || undefined;
  const draftCategoryEl = document.getElementById('icp-draft-category');
  const draftCategory = draftCategoryEl?.value || undefined;
  const wordCountEl = document.getElementById('icp-word-count');
  const desiredWordCount = wordCountEl?.value || undefined;

  // Source priority controls (checkbox lists)
  const primarySources = icpGetCheckedSources('icp-primary-sources');
  const secondarySources = icpGetCheckedSources('icp-secondary-sources');
  const searchAllEl = document.getElementById('icp-search-all');
  const searchAll = searchAllEl ? searchAllEl.checked : true;
  const sourcePriority = (primarySources.length > 0 || secondarySources.length > 0)
    ? { primarySources, secondarySources, searchAll, corpusFolder }
    : undefined;

  icpState.creating = true;
  icpState.pipelineStages = null;
  const runBtn = document.getElementById('icp-run-btn');
  const statusEl = document.getElementById('icp-pipeline-status');
  if (runBtn) { runBtn.disabled = true; runBtn.textContent = 'Running pipeline...'; }
  if (statusEl) { statusEl.innerHTML = '<span class="pipeline-running">Decomposing prompt, retrieving evidence, verifying quotes...</span>'; }

  try {
    const data = await icpPost('/session', { prompt, sourceScope, styleProfileId, corpusFolder, draftCategory, desiredWordCount, sourcePriority });
    icpState.currentSessionId = data.sessionId;
    icpState.session = data.session;
    icpState.pipelineStages = data.pipeline_stages || null;
    await loadICPSessions();
    icpSwitchPanel('evidence');
  } catch (err) {
    showICPError('Failed to create session: ' + err.message);
  } finally {
    icpState.creating = false;
    if (runBtn) { runBtn.disabled = false; runBtn.textContent = 'Run Pipeline'; }
    if (statusEl) { statusEl.innerHTML = ''; }
  }
}

/**
 * Run the FULL ICP pipeline (stages 1-11) via the parity endpoint.
 * This calls ICPOrchestrator.run() on the server — identical to the CLI.
 * Produces claims, atoms, bindings, constrained generation, citations,
 * quality gauntlet, endnotes, and bibliography.
 */
async function icpRunFullPipeline() {
  if (icpState.creating) return;

  const promptEl = document.getElementById('icp-prompt-input');
  const prompt = promptEl?.value?.trim();
  if (!prompt) {
    showICPError('Enter a research prompt before running.');
    return;
  }

  const minRelEl = document.getElementById('icp-min-relevance');
  const minRelevance = minRelEl ? parseFloat(minRelEl.value) || 0.35 : 0.35;
  const maxChunksEl = document.getElementById('icp-max-chunks');
  const maxChunks = maxChunksEl ? parseInt(maxChunksEl.value) || 40 : 40;

  const styleEl = document.getElementById('icp-style-profile');
  const styleProfileId = styleEl?.value || undefined;
  const corpusFolderEl = document.getElementById('icp-corpus-folder');
  const corpusFolder = corpusFolderEl?.value || undefined;
  const draftCategoryEl = document.getElementById('icp-draft-category');
  const draftCategory = draftCategoryEl?.value || undefined;
  const wordCountEl = document.getElementById('icp-word-count');
  const desiredWordCount = wordCountEl?.value || undefined;

  // Source priority controls (checkbox lists)
  const primarySources = icpGetCheckedSources('icp-primary-sources');
  const secondarySources = icpGetCheckedSources('icp-secondary-sources');
  const searchAllEl = document.getElementById('icp-search-all');
  const searchAll = searchAllEl ? searchAllEl.checked : true;
  const sourcePriority = (primarySources.length > 0 || secondarySources.length > 0)
    ? { primarySources, secondarySources, searchAll, corpusFolder }
    : undefined;

  icpState.creating = true;
  icpState.pipelineStages = null;
  icpState.pipelineResult = null;
  const runBtn = document.getElementById('icp-run-full-btn');
  const evidenceBtn = document.getElementById('icp-run-btn');
  const statusEl = document.getElementById('icp-pipeline-status');
  if (runBtn) { runBtn.disabled = true; runBtn.textContent = 'Running full pipeline...'; }
  if (evidenceBtn) { evidenceBtn.disabled = true; }
  if (statusEl) {
    statusEl.innerHTML = '<span class="pipeline-running">Running full pipeline: decompose \u2192 retrieve \u2192 rank \u2192 verify \u2192 claims \u2192 atoms \u2192 bind \u2192 generate \u2192 citations \u2192 quality gates...</span>';
  }

  try {
    const data = await icpPost('/pipeline', {
      prompt,
      corpusFolder,
      styleProfileId,
      desiredWordCount,
      draftCategory,
      minRelevance,
      maxChunks,
      sourcePriority,
    });
    icpState.currentSessionId = data.sessionId;
    icpState.session = data.session;
    icpState.pipelineResult = data.pipelineResult || null;
    icpState.exportPackage = data.exportPackage || null;

    // Build pipeline stages summary from result
    const pr = data.pipelineResult;
    if (pr) {
      icpState.pipelineStages = [
        { stage: 'full-pipeline', status: pr.success ? 'completed' : 'failed',
          detail: `${pr.wordCount} words, ${pr.claims} claims, ${pr.atoms} atoms, ${pr.bindings} bindings, ${pr.quoteSpans} spans, ${(pr.elapsedMs / 1000).toFixed(1)}s` },
      ];
    }

    await loadICPSessions();
    // Go directly to export panel since full pipeline is done
    icpSwitchPanel('export');
  } catch (err) {
    showICPError('Full pipeline failed: ' + err.message);
  } finally {
    icpState.creating = false;
    if (runBtn) { runBtn.disabled = false; runBtn.textContent = 'Run Full Pipeline'; }
    if (evidenceBtn) { evidenceBtn.disabled = false; }
    if (statusEl) { statusEl.innerHTML = ''; }
  }
}

