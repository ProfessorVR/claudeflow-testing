function renderPlannerPanel(container, session) {
  const plan = session.paragraph_plan || [];
  const atoms = session.atoms || [];
  const spans = session.quote_spans || [];

  const totalAtoms = atoms.length;
  const coveredAtomIds = new Set();
  plan.forEach(p => (p.atom_ids || []).forEach(id => coveredAtomIds.add(id)));

  // Unassigned atoms — not in any paragraph
  const assignedAtomIds = new Set();
  plan.forEach(p => (p.atom_ids || []).forEach(id => assignedAtomIds.add(id)));
  const unassignedAtoms = atoms.filter(a => !assignedAtomIds.has(a.atom_id));

  container.innerHTML = `
    <div class="icp-planner">
      <h3>Paragraph Plan</h3>
      <div class="planner-coverage">
        <span>Atoms covered: ${coveredAtomIds.size} / ${totalAtoms}</span>
        <div class="coverage-bar">
          <div class="coverage-fill" style="width:${totalAtoms > 0 ? (coveredAtomIds.size / totalAtoms * 100) : 0}%"></div>
        </div>
      </div>

      <div class="planner-actions">
        <button class="btn btn-primary" onclick="icpAssembleSuperPrompts()">Assemble SuperPrompts</button>
        <button class="btn btn-secondary" onclick="icpExecuteGeneration()">Execute &amp; Generate</button>
      </div>

      <div class="planner-paragraphs" id="icp-planner-cards">
        ${plan.length === 0 ? '<p class="muted">No paragraph plan yet</p>' : plan.map((p, i) => renderPlanCard(p, i, atoms, spans)).join('')}
      </div>

      ${unassignedAtoms.length > 0 ? `
        <div class="unassigned-pool">
          <h4>Unassigned Atoms (${unassignedAtoms.length})</h4>
          <div class="unassigned-atoms-list">
            ${unassignedAtoms.map(a => `
              <span class="unassigned-atom" title="${safeAttr(a.display_text)}">${escapeHtml(a.display_text.slice(0, 60))}${a.display_text.length > 60 ? '...' : ''}</span>
            `).join('')}
          </div>
        </div>
      ` : ''}
    </div>
  `;

  // Attach drag-and-drop handlers
  setupPlannerDragDrop();
}

function renderPlanCard(p, index, atoms, spans) {
  const atomCount = (p.atom_ids || []).length;
  const quoteCount = (p.required_quotes || []).length;
  const paragraphAtoms = (p.atom_ids || []).map(id => atoms.find(a => a.atom_id === id)).filter(Boolean);
  const paragraphQuotes = (p.required_quotes || []).map(id => spans.find(s => s.quote_id === id)).filter(Boolean);

  return `
    <div class="icp-plan-card" draggable="true" data-paragraph-id="${safeAttr(p.paragraph_id)}" data-index="${index}">
      <div class="plan-card-header">
        <span class="plan-drag-handle">&#9776;</span>
        <span class="plan-order">P${index + 1}</span>
        <span class="plan-summary">${atomCount} atoms &middot; ${quoteCount} quotes</span>
        <span class="plan-card-expand" onclick="icpTogglePlanCard('${safeAttr(p.paragraph_id)}')">&#9660; expand</span>
      </div>
      <div class="plan-card-detail" id="plan-detail-${safeAttr(p.paragraph_id)}">
        <div class="plan-detail-section">
          <strong>Atoms</strong>
          ${paragraphAtoms.map(a => `
            <div class="plan-atom-row">
              <span class="plan-atom-text" title="${safeAttr(a.atom_id)}">${escapeHtml(a.display_text.slice(0, 80))}</span>
              <span class="plan-atom-remove" onclick="icpRemoveAtomFromPlan('${safeAttr(p.paragraph_id)}', '${safeAttr(a.atom_id)}')">[x]</span>
            </div>
          `).join('')}
          <div class="plan-add-btn" onclick="icpShowAddAtom('${safeAttr(p.paragraph_id)}')">[+ Add atom from pool]</div>
          <div id="plan-add-atom-${safeAttr(p.paragraph_id)}" style="display:none"></div>
        </div>
        <div class="plan-detail-section" style="margin-top:8px">
          <strong>Required Quotes</strong>
          ${paragraphQuotes.map(q => `
            <div class="plan-atom-row">
              <span class="plan-atom-text">"${escapeHtml((q.text || '').slice(0, 60))}..."</span>
              <span class="plan-atom-remove" onclick="icpRemoveQuoteFromPlan('${safeAttr(p.paragraph_id)}', '${safeAttr(q.quote_id)}')">[x]</span>
            </div>
          `).join('')}
          <div class="plan-add-btn" onclick="icpShowAddQuote('${safeAttr(p.paragraph_id)}')">[+ Add quote]</div>
          <div id="plan-add-quote-${safeAttr(p.paragraph_id)}" style="display:none"></div>
        </div>
      </div>
    </div>
  `;
}

function setupPlannerDragDrop() {
  const cards = document.querySelectorAll('.icp-plan-card[draggable]');
  cards.forEach(card => {
    card.addEventListener('dragstart', function(e) {
      e.dataTransfer.setData('text/plain', this.dataset.index);
      this.classList.add('dragging');
    });
    card.addEventListener('dragend', function() {
      this.classList.remove('dragging');
      document.querySelectorAll('.icp-plan-card').forEach(c => c.classList.remove('drag-over'));
    });
    card.addEventListener('dragover', function(e) {
      e.preventDefault();
      this.classList.add('drag-over');
    });
    card.addEventListener('dragleave', function() {
      this.classList.remove('drag-over');
    });
    card.addEventListener('drop', function(e) {
      e.preventDefault();
      this.classList.remove('drag-over');
      const fromIdx = parseInt(e.dataTransfer.getData('text/plain'));
      const toIdx = parseInt(this.dataset.index);
      if (fromIdx !== toIdx) {
        icpReorderPlan(fromIdx, toIdx);
      }
    });
  });
}

function icpTogglePlanCard(paragraphId) {
  const detail = document.getElementById('plan-detail-' + paragraphId);
  if (detail) {
    detail.classList.toggle('expanded');
  }
}

function icpReorderPlan(fromIdx, toIdx) {
  if (!icpState.session) return;
  const plan = [...icpState.session.paragraph_plan];
  const [moved] = plan.splice(fromIdx, 1);
  plan.splice(toIdx, 0, moved);
  // Reassign paragraph_order
  plan.forEach((p, i) => { p.paragraph_order = i; });
  icpState.session.paragraph_plan = plan;
  icpSavePlan();
}

function icpRemoveAtomFromPlan(paragraphId, atomId) {
  if (!icpState.session) return;
  const entry = icpState.session.paragraph_plan.find(p => p.paragraph_id === paragraphId);
  if (!entry) return;
  entry.atom_ids = (entry.atom_ids || []).filter(id => id !== atomId);
  icpSavePlan();
}

function icpAddAtomToPlan(paragraphId, atomId) {
  if (!icpState.session) return;
  const entry = icpState.session.paragraph_plan.find(p => p.paragraph_id === paragraphId);
  if (!entry) return;
  if (!entry.atom_ids.includes(atomId)) {
    entry.atom_ids.push(atomId);
  }
  icpSavePlan();
}

function icpRemoveQuoteFromPlan(paragraphId, quoteId) {
  if (!icpState.session) return;
  const entry = icpState.session.paragraph_plan.find(p => p.paragraph_id === paragraphId);
  if (!entry) return;
  entry.required_quotes = (entry.required_quotes || []).filter(id => id !== quoteId);
  icpSavePlan();
}

function icpAddQuoteToPlan(paragraphId, quoteId) {
  if (!icpState.session) return;
  const entry = icpState.session.paragraph_plan.find(p => p.paragraph_id === paragraphId);
  if (!entry) return;
  if (!entry.required_quotes) entry.required_quotes = [];
  if (!entry.required_quotes.includes(quoteId)) {
    entry.required_quotes.push(quoteId);
  }
  icpSavePlan();
}

function icpShowAddAtom(paragraphId) {
  if (!icpState.session) return;
  const container = document.getElementById('plan-add-atom-' + paragraphId);
  if (!container) return;
  if (container.style.display !== 'none') {
    container.style.display = 'none';
    return;
  }
  const assignedIds = new Set();
  icpState.session.paragraph_plan.forEach(p => (p.atom_ids || []).forEach(id => assignedIds.add(id)));
  const unassigned = (icpState.session.atoms || []).filter(a => !assignedIds.has(a.atom_id));
  if (unassigned.length === 0) {
    container.innerHTML = '<div class="muted" style="font-size:0.8em;padding:4px">No unassigned atoms</div>';
  } else {
    container.innerHTML = '<select onchange="if(this.value){icpAddAtomToPlan(\'' + safeAttr(paragraphId) + '\',this.value);}" style="width:100%;margin-top:4px;padding:4px;background:#151515;color:#e0e0e0;border:1px solid #444;border-radius:3px;font-size:0.8em"><option value="">Select atom...</option>'
      + unassigned.map(a => '<option value="' + safeAttr(a.atom_id) + '">' + escapeHtml(a.display_text.slice(0, 60)) + '</option>').join('')
      + '</select>';
  }
  container.style.display = 'block';
}

function icpShowAddQuote(paragraphId) {
  if (!icpState.session) return;
  const container = document.getElementById('plan-add-quote-' + paragraphId);
  if (!container) return;
  if (container.style.display !== 'none') {
    container.style.display = 'none';
    return;
  }
  const assignedQuotes = new Set();
  icpState.session.paragraph_plan.forEach(p => (p.required_quotes || []).forEach(id => assignedQuotes.add(id)));
  const available = (icpState.session.quote_spans || []).filter(s => !assignedQuotes.has(s.quote_id));
  if (available.length === 0) {
    container.innerHTML = '<div class="muted" style="font-size:0.8em;padding:4px">No available quotes</div>';
  } else {
    container.innerHTML = '<select onchange="if(this.value){icpAddQuoteToPlan(\'' + safeAttr(paragraphId) + '\',this.value);}" style="width:100%;margin-top:4px;padding:4px;background:#151515;color:#e0e0e0;border:1px solid #444;border-radius:3px;font-size:0.8em"><option value="">Select quote...</option>'
      + available.map(q => '<option value="' + safeAttr(q.quote_id) + '">"' + escapeHtml((q.text || '').slice(0, 50)) + '..."</option>').join('')
      + '</select>';
  }
  container.style.display = 'block';
}

async function icpSavePlan() {
  if (!icpState.session || !icpState.currentSessionId) return;
  try {
    const result = await icpFetch('/plan/' + icpState.currentSessionId, {
      method: 'PUT',
      body: JSON.stringify({ paragraph_plan: icpState.session.paragraph_plan }),
