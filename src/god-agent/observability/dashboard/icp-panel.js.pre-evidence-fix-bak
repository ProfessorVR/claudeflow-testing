var icpPdfCurrentZoom = 1.0;
var icpPdfIsFullscreen = false;

// =============================================================================
// DOC METADATA CACHE (for author/title on quote cards)
// =============================================================================
var icpDocMetaCache = {};

async function icpPreloadDocMeta(spans) {
  var needed = [];
  var seen = {};
  for (var i = 0; i < spans.length; i++) {
    var id = spans[i].doc_id;
    if (id && !icpDocMetaCache[id] && !seen[id]) {
      seen[id] = true;
      needed.push(id);
    }
  }
  if (!needed.length) return;
  try {
    var data = await icpPost('/doc-info-batch', { docIds: needed });
    if (data && data.docs) {
      Object.assign(icpDocMetaCache, data.docs);
    }
  } catch (e) { /* batch fetch failed — cards use fallback */ }
}

function icpUpdateCardMeta(spans) {
  for (var i = 0; i < spans.length; i++) {
    var s = spans[i];
    var meta = icpDocMetaCache[s.doc_id];
    if (!meta) continue;
    var card = document.querySelector('.icp-quote-card[data-quote-id="' + safeAttr(s.quote_id) + '"] .quote-source');
    if (!card) continue;
    var authorEl = card.querySelector('.quote-source-author');
    var titleEl = card.querySelector('.quote-source-title');
    if (authorEl && meta.author) authorEl.textContent = meta.author;
    if (titleEl && meta.title) titleEl.textContent = meta.title;
  }
}

// =============================================================================
// QUOTE TRIM FUNCTIONS
// =============================================================================

function icpUseSelection() {
  var selectable = document.getElementById('icp-quote-selectable');
  var editor = document.getElementById('icp-quote-correction');
  var sel = window.getSelection();
  if (!sel || sel.rangeCount === 0 || sel.isCollapsed) {
    showICPError('Select text first by highlighting a portion of the quote above');
    return;
  }
  var range = sel.getRangeAt(0);
  if (!selectable || !selectable.contains(range.startContainer) || !selectable.contains(range.endContainer)) return;

  var selectedText = sel.toString().trim();
  if (!selectedText) return;

  // Put trimmed text into the correction editor
  if (editor) editor.innerText = selectedText;

  // Highlight the selected range in the source div
  try {
    var mark = document.createElement('mark');
    mark.className = 'icp-trim-highlight';
    range.surroundContents(mark);
  } catch (e) { /* surroundContents can fail on partial selections spanning elements */ }
  sel.removeAllRanges();
}

function icpResetTrim() {
  var selectable = document.getElementById('icp-quote-selectable');
  var editor = document.getElementById('icp-quote-correction');
  if (selectable) {
    // Remove all trim highlight marks
    var marks = selectable.querySelectorAll('mark.icp-trim-highlight');
    for (var i = 0; i < marks.length; i++) {
      marks[i].replaceWith(marks[i].textContent);
    }
  }
  // Reset editor to full text
  if (selectable && editor) {
    var quoteId = selectable.dataset.quoteId;
    var spans = (icpState.session && icpState.session.quote_spans) || [];
    for (var j = 0; j < spans.length; j++) {
      if (spans[j].quote_id === quoteId) {
        editor.innerText = spans[j].text || '';
        break;
      }
    }
  }
}

