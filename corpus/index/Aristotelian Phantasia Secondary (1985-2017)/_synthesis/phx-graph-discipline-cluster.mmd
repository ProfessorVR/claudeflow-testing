%% Graph 3 — Three disciplinary subgraphs with inter-subgraph bridge edges
%% Philosophy-of-Mind: Nussbaum, White (Thomistic-adjacent), Frede, Caston, Papachristou
%% Rhetoric: O'Gorman, Gonzalez, Hawhee
%% Time-Perception-Hinge: AMT-01-Bowin (adjacent pipeline)
graph LR
    classDef phil fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef rhet fill:#f3e5f5,stroke:#6a1b9a,color:#000
    classDef adj fill:#eceff1,stroke:#546e7a,stroke-dasharray:4 3,color:#000

    subgraph PHIL ["Philosophy of Mind"]
        P1["PHX-01 Nussbaum"]:::phil
        P2["PHX-02 White"]:::phil
        P3["PHX-03 Frede"]:::phil
        P4["PHX-04 Caston"]:::phil
        P8["PHX-08 Papachristou"]:::phil
    end

    subgraph RHET ["Rhetoric"]
        R5["PHX-05 O'Gorman"]:::rhet
        R6["PHX-06 Gonzalez"]:::rhet
        R7["PHX-07 Hawhee"]:::rhet
    end

    subgraph HINGE ["Time-Perception Hinge"]
        AMT["AMT-01 Bowin<br/>(adjacent pipeline)"]:::adj
    end

    %% Within philosophy-of-mind
    P2 --> P1
    P3 --> P1
    P4 --> P1
    P8 --> P1
    P8 --> P2
    P8 --> P3
    P8 --> P4

    %% Within rhetoric
    R5 --> R6
    R7 --> R5
    R7 --> R6

    %% Cross-subgraph (citation bridges)
    R5 --> P1
    R5 --> P2
    R5 --> P3
    R5 --> P4
    R6 --> P1
    R6 --> P3
    R7 --> P1
    R7 --> P2
    R7 --> P3
    R7 --> P4

    %% Adjacent-pipeline dotted bridge (via De Mem 450a phantasma)
    P4 -.->|De Mem 450a| AMT
    P1 -.->|De Mem 450a| AMT
