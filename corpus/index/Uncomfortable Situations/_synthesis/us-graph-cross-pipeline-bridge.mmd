    %% US <-> Rickert candidate (max 5) — 4
    UINTRO -- "cites Ambient Rhetoric" --> RAMB
    UEQUIANO -- "books as orientation" --> RAMB
    URADCLIFFE -- "cultural attunement" --> RATT
