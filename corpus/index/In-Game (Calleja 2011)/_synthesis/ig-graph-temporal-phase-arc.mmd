flowchart LR
    subgraph MACRO["T-001 MACRO PHASE — off-line involvement"]
        direction TB
        M_KIN["KIN macro:<br/>recalling avatar-control feats"]
        M_SPA["SPA macro:<br/>spatial mental models<br/>(WoW Ratchet->Feathermoon)"]
        M_SHA["SHA macro:<br/>clan/guild work; persisting bonds"]
        M_NAR["NAR macro:<br/>speculation re designed narrative;<br/>story-construction"]
        M_AFF["AFF macro:<br/>inner peace post-session;<br/>anticipatory excite/anxiety"]
        M_LUD["LUD macro:<br/>winning-strategy formation;<br/>character-dev planning"]
    end

    subgraph MICRO["T-002 MICRO PHASE — in ludo res / in-session"]
        direction TB
        MI_KIN["KIN micro:<br/>control-internalization;<br/>Red Orchestra readiness"]
        MI_SPA["SPA micro:<br/>navigation + exploration +<br/>place-internalization"]
        MI_SHA["SHA micro:<br/>cohab/coop/compete + ambient<br/>social-context awareness"]
