  {
    "lemma": "pathos",
    "greek_unicode": "πάθος",
    "forms_encountered": ["πάθος", "πάθη", "παθῶν", "παθήματα"],
    "conventional_translations": ["emotion", "feeling", "passion", "affection", "experience"],
    "aristotle_usage": "All those feelings that so change men as to affect their judgements, and that are also attended by pain or pleasure. Second technical proof. Twelve-emotion catalogue in II.2-11. Heidegger reads as Befindlichkeit.",
