[
  {
    "lemma": "rhetorike",
    "greek_unicode": "ῥητορική",
    "forms_encountered": ["ῥητορική", "ῥητορικήν", "ῥητορικῆς"],
    "conventional_translations": ["rhetoric", "the art of rhetoric"],
    "aristotle_usage": "The faculty of observing in any given case the available means of persuasion; counterpart of dialectic; universal faculty belonging to no definite science; offshoot of dialectic and ethical studies.",
