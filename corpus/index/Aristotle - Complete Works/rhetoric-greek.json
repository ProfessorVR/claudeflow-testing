  },
  {
    "lemma": "metaphora",
    "greek_unicode": "μεταφορά",
    "forms_encountered": ["μεταφορά", "μεταφοράς", "μεταφοραί"],
    "conventional_translations": ["metaphor", "transfer of a name"],
    "aristotle_usage": "The transfer of an alien name to a thing; the supreme instrument of prose style. Gives clearness, charm, and distinction. Implies intuitive perception of similarity in dissimilars. Unteachable. Must be drawn from kindred things. Materials beautiful to sense. Achieves highest effect via energeia (pro ommaton poiein).",
    "key_loci": ["1404b32-1405b20", "1406b20-1407a17", "1410b6-1412a10"],
    "units": ["RHET-05", "RHET-06"],
    "translation_contested": false,
    "canonical_node_link": "C7",
    "global_candidate": true
  },
  {
    "lemma": "logos",
    "greek_unicode": "λόγος",
    "forms_encountered": ["λόγος", "λόγοι", "λόγον", "λόγῳ"],
    "conventional_translations": ["proof by the speech itself", "argument", "speech", "reason", "word", "account"],
    "aristotle_usage": "Third technical proof: persuasion through demonstrating a truth or apparent truth. Also: rational speech that distinguishes humans. Multiple senses operate across the Rhetoric.",
    "key_loci": ["1356a19-20", "1355a20-b7"],
    "units": ["RHET-01", "RHET-02", "RHET-03", "RHET-04", "RHET-05", "RHET-06"],
    "translation_contested": true,
