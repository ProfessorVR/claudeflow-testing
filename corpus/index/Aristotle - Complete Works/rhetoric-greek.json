  {
    "lemma": "ethos",
    "greek_unicode": "ἦθος",
    "forms_encountered": ["ἦθος", "ἤθη", "ἠθῶν", "ἠθικός"],
    "conventional_translations": ["character", "moral character", "disposition"],
    "aristotle_usage": "First technical proof: persuasion through the speaker's character as projected in the speech itself, not prior reputation. Three sources: phronesis, arete, eunoia. Character types by age and fortune in II.12-17. Heidegger reads existentially as 'way of being disposed.'",
    "key_loci": ["1356a1-13", "1377b25-1378a15", "1388b31-1391b27", "1408a28"],
    "units": ["RHET-01", "RHET-02", "RHET-03", "RHET-04", "RHET-05", "RHET-06"],
    "translation_contested": true,
