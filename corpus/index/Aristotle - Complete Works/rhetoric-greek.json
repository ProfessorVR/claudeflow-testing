  },
  {
    "lemma": "lexis",
    "greek_unicode": "λέξις",
    "forms_encountered": ["λέξις", "λέξεως", "λέξιν"],
    "conventional_translations": ["style", "diction", "manner of expression"],
    "aristotle_usage": "The manner of linguistic expression; the second of three points of study in speech-making (after invention, before arrangement). Excellence = clarity + distinction through metaphor. Distinct from poetic diction.",
    "key_loci": ["1403b15", "1404b1-1405b20", "1408a10-b15"],
    "units": ["RHET-05", "RHET-06"],
    "translation_contested": false,
