    style kinesis fill:#2e7d32,stroke:#1b5e20,color:#fff
    style to_on_hei_on fill:#283593,stroke:#1a237e,color:#fff
    style PNC fill:#283593,stroke:#1a237e,color:#fff
    style pros_hen fill:#3949ab,stroke:#1a237e,color:#fff
