  {"bekker": "220a5", "description": "\"Time is both made continuous by the now and divided at it\"", "concepts": ["χρόνος", "τὸ νῦν"], "pdf_page": 41, "unit_id": "PHYS-04", "work": "Physics"},
  {"bekker": "223a21--26", "description": "\"Whether if soul did not exist, time would exist\"", "concepts": ["χρόνος", "ψυχή"], "pdf_page": 45, "unit_id": "PHYS-04", "work": "Physics"},
