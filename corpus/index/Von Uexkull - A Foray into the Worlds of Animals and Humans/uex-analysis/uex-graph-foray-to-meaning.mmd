        Partitur["<b>Partitur</b><br/><i>World-Score</i>"]
        Kompositionslehre["<b>Kompositionslehre</b><br/><i>Composition Theory</i>"]
    end

    %% ================================================================
    %% BRIDGING EDGES (Part I --> Part II transformations)
    %% ================================================================

    %% Funktionskreis --> Bedeutungsverwertung
    FK_F ==>|"refines<br/>functional cycles<br/>become meaning cycles"| Bedeutungsverwertung

    %% Merkmal / Wirkmal --> Bedeutungstraeger
    Merkmal_F ==>|"refines<br/>marks become marks<br/>on carriers of meaning"| Bedeutungstraeger
    Wirkmal_F ==>|"operationalizes<br/>effect marks operate<br/>on meaning-carriers"| Bedeutungstraeger

    %% Gegengefuege --> Kontrapunkt
    Gegengefuege_F ==>|"refines<br/>object-level counter-<br/>structure generalizes to<br/>cross-Umwelt counterpoint"| Kontrapunkt

    %% Merkzeichen --> Eigenton
    Merkzeichen_F ==>|"explains<br/>perception signs<br/>grounded in cell<br/>self-tones"| Eigenton

    %% Planmäßigkeit --> Bedeutungsregel
    Planmaessigkeit_F ==>|"refines<br/>plan-conformity<br/>becomes meaning rule"| Bedeutungsregel

    %% Merkbild --> Urbild
    Merkbild_F ==>|"presupposes<br/>individual perception<br/>image grounded in<br/>species archetype"| Urbild

    %% Suchbild --> Urbild
    Suchbild_F ==>|"presupposes<br/>innate search images<br/>suggest species-level<br/>primal images"| Urbild

    %% Wirkton --> Bedeutungstraeger
    Wirkton_F ==>|"refines<br/>effect tone becomes<br/>meaning-tone on<br/>carriers"| Bedeutungstraeger

    %% Suchton --> Bedeutungsregel
    Suchton_F ==>|"presupposes<br/>function-oriented search<br/>systematized as<br/>meaning rule"| Bedeutungsregel

    %% Stimmung --> Bedeutungstraeger
    Stimmung_F ==>|"explains<br/>mood determines<br/>meaning-switch"| Bedeutungstraeger

    %% Subjekt --> Bedeutungsverbraucher
    Subjekt_F ==>|"refines<br/>subject reframed as<br/>consumer of meaning"| Bedeutungsverbraucher

    %% Umwelt --> Wohnhülle
    Umwelt_F ==>|"refines<br/>extended to plants<br/>as dwelling-shell"| Wohnhuelle

    %% Magische Umwelt --> Bedeutungsplan
    Magische_F ==>|"presupposes<br/>free productions<br/>point to supra-individual<br/>meaning plan"| Bedeutungsplan

    %% Natur --> Partitur
    Natur_F ==>|"refines<br/>unknowable totality<br/>becomes composed<br/>world-score"| Partitur

    %% === STYLING ===
    style PART_I fill:#f0f8ff,stroke:#2c5282,stroke-width:2px
    style PART_II fill:#fff8f0,stroke:#9c4221,stroke-width:2px
