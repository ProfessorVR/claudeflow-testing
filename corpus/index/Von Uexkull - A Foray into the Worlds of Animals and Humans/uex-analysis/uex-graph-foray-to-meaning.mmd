        FK_F["<b>Funktionskreis</b><br/><i>Functional Cycle</i>"]
        Merkmal_F["<b>Merkmal</b><br/><i>Perception Mark</i>"]
        Wirkmal_F["<b>Wirkmal</b><br/><i>Effect Mark</i>"]
        Gegengefuege_F["<b>Gegengefüge</b><br/><i>Counterstructure</i>"]
        Merkzeichen_F["<b>Merkzeichen</b><br/><i>Perception Sign</i>"]
        Planmaessigkeit_F["<b>Planmäßigkeit</b><br/><i>Conformity to Plan</i>"]
        Merkbild_F["<b>Merkbild</b><br/><i>Perception Image</i>"]
        Wirkton_F["<b>Wirkton</b><br/><i>Effect Tone</i>"]
        Suchton_F["<b>Suchton</b><br/><i>Search Tone</i>"]
        Stimmung_F["<b>Stimmung</b><br/><i>Mood</i>"]
        Umwelt_F["<b>Umwelt</b><br/><i>Environment</i>"]
