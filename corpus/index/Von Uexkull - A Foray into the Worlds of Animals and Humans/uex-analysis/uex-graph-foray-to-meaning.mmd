        Magische_F["<b>Magische Umwelt</b><br/><i>Magical Environment</i>"]
    end

    %% ================================================================
    %% RIGHT SIDE: PART II — THEORY OF MEANING (U-M1 through U-M6)
    %% ================================================================

    subgraph PART_II["Part II: <i>The Theory of Meaning</i>"]
        Bedeutungsverwertung["<b>Bedeutungsverwertung</b><br/><i>Meaning Utilization</i>"]
        Bedeutungstraeger["<b>Bedeutungsträger</b><br/><i>Carrier of Meaning</i>"]
        Kontrapunkt["<b>Kontrapunkt</b><br/><i>Counterpoint</i>"]
        Eigenton["<b>Eigenton</b><br/><i>Self-Tone</i>"]
        Bedeutungsregel["<b>Bedeutungsregel</b><br/><i>Meaning Rule</i>"]
