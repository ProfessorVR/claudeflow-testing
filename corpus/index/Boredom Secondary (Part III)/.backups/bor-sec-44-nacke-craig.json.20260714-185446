  "readings": [
    { "claim": "The flow-designed level produced the highest scores on every physiological measure taken (OO, ZM, GSR), constituting measurable high-arousal positive affect, consistent with the hypothesis that flow/challenge produces joy rather than frustration.", "type": "READING/CLAIM", "stance": "asserts", "locus": "p.86-87", "tag": "FAITHFUL-Lindley & Nacke" },
    { "claim": "GEQ subjective reports discriminated the three conditions on only 2 of 7 subscales (challenge, tension); immersion, flow, competence, positive affect, and negative affect subscales showed no significant condition effect.", "type": "READING/CLAIM", "stance": "reports (qualifies own method's discriminant power)", "locus": "p.86", "tag": "FAITHFUL-Lindley & Nacke" },
    { "claim": "The MEC Spatial Presence Questionnaire discriminated the immersion condition from the other two (highest on self-location and possible actions) where the GEQ's own immersion subscale could not, suggesting spatial presence is a more sensitive index of designed-for immersion than the general GEQ immersion subscale.", "type": "READING/CLAIM", "stance": "asserts", "locus": "p.86-87", "tag": "FE" },
    { "claim": "This study's positive EMG-flow relationship (significant OO and ZM effects) contradicts Kivikangas's (2006) prior finding of no significant relationship between zygomaticus/orbicularis EMG activity and flow.", "type": "READING/CLAIM", "stance": "contests (a prior null finding)", "locus": "p.87", "tag": "FAITHFUL-Lindley & Nacke" },
    { "claim": "Joy in the flow condition is attributed to challenging gameplay itself, not to victory or successful completion, since combat difficulty increased gradually and culminated in a demanding end-fight rather than a rewarding win state.", "type": "READING/CLAIM", "stance": "asserts (theoretical interpretation)", "locus": "p.87", "tag": "FE" },
    { "claim": "The fixed, non-counterbalanced order in which all participants played boredom-then-immersion-then-flow (or whichever single order was used) risks a learning-effect confound, though the authors judge this risk minor since the three experiential dimensions only marginally overlap -- an assumption not empirically tested.", "type": "READING/CLAIM", "stance": "concedes", "locus": "p.84", "tag": "FAITHFUL-Lindley & Nacke" },
