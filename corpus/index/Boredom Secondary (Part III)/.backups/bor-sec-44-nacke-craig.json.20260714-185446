  "measures": [
    { "label": "self-report / survey scale", "signal": "Game Experience Questionnaire (GEQ: immersion, tension, competence, flow, negative affect, positive affect, challenge subscales) + MEC Spatial Presence Questionnaire (self-location, possible-actions subscales); administered after each of 3 modality plays", "apparatus": "paper/computer questionnaire, IJsselsteijn/Poels/de Kort GEQ (FUGA project) + Vorderer et al. (2004) MEC-SPQ", "sampleN": "25 recruited; analytic N approx 21 for the reported repeated-measures ANOVAs (inferred from F(2,40) degrees of freedom -- not explicitly restated by the authors)", "keyResult": "GEQ significant only for challenge (F(2,40)=32.54, p<.05) and tension (F(2,40)=7.98, p<.05) among 7 subscales; boredom level lowest on challenge/immersion/flow but highest on competence, flow level lowest on competence but highest on flow/challenge/tension. MEC-SPQ significant for both possible actions (F(2,40)=4.79, p<.05) and self-location (F(2,40)=3.40, p<.05); immersion level scored highest on both, boredom level lowest.", "locus": "p.84-87" },
    { "label": "facial electromyography (EMG) [own-term measure; no exact controlled-vocabulary match -- nearest conceptual neighbor is an autonomic/psychophysiological valence measure, outside the given MEASURE-axis columns]", "signal": "rectified EMG at orbicularis oculi (OO, positive valence), corrugator supercilii (CS, negative valence), zygomaticus major (ZM, positive valence), per Lang's (1995) dimensional valence-arousal theory of emotion", "apparatus": "BioSemi flat-type active Ag-AgCl electrodes (11x17x4.5mm, Signa gel), ActiveTwo AD-box at 2kHz, ActiView software; band-pass filtered 30-400Hz (per Fridlund & Cacioppo, 1986, guidelines)", "sampleN": "25 recruited; analytic N approx 16 for reported ANOVAs/contrasts (inferred from F(2,30)/F(1,15) degrees of freedom -- not explicitly restated by the authors)", "keyResult": "OO significant, F(2,30)=3.77, p<.05 (flow highest, 8.47microV); ZM significant, F(2,30)=7.51, p<.05 (flow highest, 10.98microV); CS non-significant, F(2,30)=0.98, p>.05. Within-subject contrasts: flow>boredom for OO (F(1,15)=7.02, p<.05) and ZM (F(1,15)=7.88, p<.05); flow>immersion for ZM only (F(1,15)=10.05, p<.05). Contradicts Kivikangas's (2006) null EMG-flow finding.", "locus": "p.84-85, 87" },
