# Perplexity API Configuration
# Get your API key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Other API keys for future integrations
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# vLLM Local Model Server Configuration
VLLM_BASE_URL=http://localhost:8002

# ============================================================
# LOCAL-FIRST ROUTING CONFIGURATION
# ============================================================
# These settings control the intelligent routing system that
# maximizes local vLLM usage and minimizes cloud API costs.
#
# The goal is to use local models for 70%+ of tasks, with
# Claude only used for complex/high-risk situations.
# ============================================================

# Master switch for local-first mode (default: true)
# When enabled, the system tries local vLLM before Claude
GOD_ROUTER_LOCAL_FIRST=true

# Minimum success rate to trust local model (default: 0.50)
# Lower = more aggressive local usage, Higher = more conservative
# Range: 0.0 - 1.0
GOD_ROUTER_LOCAL_THRESHOLD=0.50

# Trust test results for verification (default: true)
# When true, passing tests skip Claude review entirely
GOD_ROUTER_TRUST_TESTS=true

# Default risk level for unknown patterns (default: low)
# Options: low, medium, high
# "low" = try local first, "medium" = local + Claude review, "high" = Claude only
GOD_ROUTER_DEFAULT_RISK=low

# Maximum retries with local model before Claude fallback (default: 2)
GOD_ROUTER_MAX_LOCAL_RETRIES=2

# Quality threshold for accepting local output (default: 0.70)
# Outputs below this quality score fall back to Claude
# Range: 0.0 - 1.0
GOD_ROUTER_LOCAL_QUALITY=0.70

# Always try local first, even for high-risk tasks (default: true)
# When true, even "expensive" routes try local first
GOD_ROUTER_ALWAYS_TRY_LOCAL=true

# ============================================================
# COST TRACKING
# ============================================================

# Enable cost tracking (default: false)
GOD_COST_TRACKING_ENABLED=false

# Budget limits in USD
GOD_BUDGET_DAILY=10
GOD_BUDGET_WEEKLY=50
GOD_BUDGET_MONTHLY=150
