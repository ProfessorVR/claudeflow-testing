  "StreamDeckSetupInstructions": {
    "Step1": "Open Stream Deck app → Create new Profile named 'God Agent'",
    "Step2": "For each button: drag 'Open' action onto the key slot",
    "Step3": "Set App to 'Terminal', set Title to the label (e.g. STATUS)",
    "Step4": "In the path field, set: /path/to/god-agent-streamdeck/scripts/god-<name>.sh",
    "Step5": "Optional: right-click → set Icon for visual reference",
    "Step6": "Row 3 buttons 1-4 are empty — assign anything you want",
    "Tip": "Set GOD_AGENT_DIR in your shell profile to avoid hardcoding the path"
  },

  "EnvironmentVariables": {
    "GOD_AGENT_DIR": "Path to your god-agent-package directory (default: ~/god-agent-package)",
    "GOD_AGENT_DASHBOARD": "Path to dashboard/index.html (default: ~/god-agent-streamdeck/dashboard/index.html)"
  }
